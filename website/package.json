{
  "name": "@taffygo/website",
  "version": "0.0.0",
  "private": true,
  "description": "TaffyGo landing page: a Next.js static export.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/export-markdown.mjs && node scripts/export-service-worker.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

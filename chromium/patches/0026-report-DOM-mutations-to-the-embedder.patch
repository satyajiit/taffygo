new file mode 100644
index 0000000000000..bb0de037dee36
--- /dev/null
+++ b/third_party/blink/public/web/web_dom_mutation_observer.h
@@ -0,0 +1,87 @@
+// Copyright 2026 The TaffyGo Authors
+// Use of this source code is governed by a BSD-style license that can be found
+// in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_DOM_MUTATION_OBSERVER_H_
+#define THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_DOM_MUTATION_OBSERVER_H_
+
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "third_party/blink/public/platform/web_common.h"
+#include "third_party/blink/public/platform/web_string.h"
+
+namespace blink {
+
+class WebDocument;
+
+// One delivered DOM mutation, reduced to the facts an embedder outside Blink
+// can act on: what kind of change it was, which nodes it names, and - for an
+// attribute change - which attribute.
+//
+// Nodes are named by blink::WebNode::GetDomNodeId() values rather than by
+// WebNode, so a consumer can match a mutation against records it keyed off
+// GetDomNodeId() without holding a reference to anything in the Blink heap.
+// Zero means "no node".
+struct WebDomMutation {
+  enum class Kind {
+    // Children of `target_dom_node_id` were added, removed, or both.
+    kChildList,
+    // `attribute_name` changed on `target_dom_node_id`.
+    kAttributes,
+    // The character data of `target_dom_node_id` changed. That node is a text
+    // node rather than an element, which is why `parent_dom_node_id` is
+    // reported beside it.
+    kCharacterData,
+  };
+
+  Kind kind = Kind::kChildList;
+
+  int target_dom_node_id = 0;
+  int parent_dom_node_id = 0;
+  std::vector<int> added_dom_node_ids;
+  std::vector<int> removed_dom_node_ids;
+
+  // Only meaningful when `kind` is kAttributes.
+  WebString attribute_name;
+};
+
+// Reports DOM mutations in one document to a callback outside Blink.
+//
+// This is the same mechanism Blink's own C++ consumers use - a
+// MutationObserver with a native delegate - exposed at the public boundary,
+// in the shape WebFormElementObserver already established for a narrower
+// question. It exists because content::RenderFrameObserver has no DOM
+// mutation callback at all, so an embedder that must know when a document
+// changed has no signal to subscribe to.
+//
+// The observer watches the whole document (childList, attributes and
+// character data, subtree) for as long as it is connected, so a consumer that
+// only sometimes needs the signal should create it only sometimes.
+class BLINK_EXPORT WebDomMutationObserver {
+ public:
+  using Callback =
+      base::RepeatingCallback<void(const std::vector<WebDomMutation>&)>;
+
+  // Creates an observer over `document`. The returned object keeps itself
+  // alive until Disconnect() is called, exactly as WebFormElementObserver
+  // does; Disconnect() also releases `callback`.
+  static WebDomMutationObserver* Create(const WebDocument& document,
+                                        Callback callback);
+
+  virtual void Disconnect() = 0;
+
+  // Pulls records MutationObserver has queued but not yet Delivered, and
+  // invokes the callback. Agent-event-loop microtasks are the normal path;
+  // this exists so a delta subscriber can drain while the page is not
+  // compositing, without a repeating timer on every observed document.
+  virtual void FlushPending() = 0;
+
+ protected:
+  WebDomMutationObserver() = default;
+  virtual ~WebDomMutationObserver() = default;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_DOM_MUTATION_OBSERVER_H_

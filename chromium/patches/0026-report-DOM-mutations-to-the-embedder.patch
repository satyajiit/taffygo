diff --git a/third_party/blink/renderer/core/exported/web_dom_mutation_observer_impl.cc b/third_party/blink/renderer/core/exported/web_dom_mutation_observer_impl.cc
new file mode 100644
index 0000000000000..5c4a5635e5832
--- /dev/null
+++ b/third_party/blink/renderer/core/exported/web_dom_mutation_observer_impl.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The TaffyGo Authors
+// Use of this source code is governed by a BSD-style license that can be found
+// in the LICENSE file.
+
+#include "third_party/blink/renderer/core/exported/web_dom_mutation_observer_impl.h"
+
+#include <utility>
+
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_mutation_observer_init.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/dom_node_ids.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/mutation_observer.h"
+#include "third_party/blink/renderer/core/dom/mutation_record.h"
+#include "third_party/blink/renderer/core/dom/node.h"
+#include "third_party/blink/renderer/core/dom/node_traversal.h"
+#include "third_party/blink/renderer/core/dom/static_node_list.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+
+namespace blink {
+
+namespace {
+
+int DomNodeIdOf(Node* node) {
+  return node ? static_cast<int>(node->GetDomNodeId()) : 0;
+}
+
+// A removal is the removal of a subtree, but MutationObserver names only the
+// node that left its parent. A consumer told about that node alone would keep
+// every descendant's identity resolvable after the DOM those identities
+// described is gone, which is the exact shape of a stale handle that still
+// answers.
+//
+// Only nodes that already carry a DOM node id are reported. An id is assigned
+// the first time anything asks for one, so a node without one has never been
+// named to anybody and can appear in no consumer's records - and asking here
+// would assign ids to a subtree on its way out.
+void AppendRemovedSubtree(Node* removed, std::vector<int>& out) {
+  if (!removed) {
+    return;
+  }
+  for (Node& node : NodeTraversal::InclusiveDescendantsOf(*removed)) {
+    if (const DOMNodeId id = DOMNodeIds::ExistingIdForNode(&node)) {
+      out.push_back(static_cast<int>(id));
+    }
+  }
+}
+
+}  // namespace
+
+class WebDomMutationObserverImpl::ObserverCallback
+    : public MutationObserver::Delegate {
+ public:
+  ObserverCallback(Document& document,
+                   WebDomMutationObserver::Callback callback)
+      : document_(document),
+        mutation_observer_(MutationObserver::Create(this)),
+        callback_(std::move(callback)) {
+    // The whole tree, every kind of change. A narrower registration would be
+    // a decision about which mutations matter, and that decision belongs to
+    // the consumer rather than to this bridge.
+    //
+    // documentElement, not Document, is the target. Observing Document with
+    // subtree is spec-legal and is what a script typically writes, but a
+    // C++ observer on Document is easy to leave attached to the Document
+    // node while every later mutation is a descendant of <html>. Targeting
+    // the element the mutations actually live under is the same coverage
+    // with one less way to miss them. A document with no element yet falls
+    // back to the Document node so the first insertion is still seen.
+    MutationObserverInit* init = MutationObserverInit::Create();
+    init->setChildList(true);
+    init->setSubtree(true);
+    init->setAttributes(true);
+    init->setCharacterData(true);
+    Node* target = document_->documentElement();
+    if (!target) {
+      target = document_;
+    }
+    mutation_observer_->observe(target, init, ASSERT_NO_EXCEPTION);
+  }
+
+  ExecutionContext* GetExecutionContext() const override {
+    return document_ ? document_->GetExecutionContext() : nullptr;
+  }
+
+  void Deliver(const MutationRecordVector& records,
+               MutationObserver&) override {
+    if (callback_.is_null()) {
+      return;
+    }
+    std::vector<WebDomMutation> mutations;
+    mutations.reserve(records.size());
+    for (const auto& record : records) {
+      WebDomMutation mutation;
+      Node* target = record->target();
+      mutation.target_dom_node_id = DomNodeIdOf(target);
+      mutation.parent_dom_node_id =
+          target ? DomNodeIdOf(target->parentNode()) : 0;
+
+      if (record->type() == "childList") {
+        mutation.kind = WebDomMutation::Kind::kChildList;
+        if (StaticNodeList* added = record->addedNodes()) {
+          for (unsigned i = 0; i < added->length(); ++i) {
+            mutation.added_dom_node_ids.push_back(DomNodeIdOf(added->item(i)));
+          }
+        }
+        if (StaticNodeList* removed = record->removedNodes()) {
+          for (unsigned i = 0; i < removed->length(); ++i) {
+            AppendRemovedSubtree(removed->item(i),
+                                 mutation.removed_dom_node_ids);
+          }
+        }
+      } else if (record->type() == "attributes") {
+        mutation.kind = WebDomMutation::Kind::kAttributes;
+        mutation.attribute_name = WebString(record->attributeName());
+      } else {
+        mutation.kind = WebDomMutation::Kind::kCharacterData;
+      }
+      mutations.push_back(std::move(mutation));
+    }
+    callback_.Run(mutations);
+  }
+
+  void Disconnect() {
+    mutation_observer_->disconnect();
+    callback_.Reset();
+  }
+
+  void FlushPending() {
+    if (callback_.is_null() || !mutation_observer_) {
+      return;
+    }
+    const MutationRecordVector records = mutation_observer_->takeRecords();
+    if (!records.empty()) {
+      Deliver(records, *mutation_observer_);
+    }
+  }
+
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(document_);
+    visitor->Trace(mutation_observer_);
+    MutationObserver::Delegate::Trace(visitor);
+  }
+
+ private:
+  Member<Document> document_;
+  Member<MutationObserver> mutation_observer_;
+  WebDomMutationObserver::Callback callback_;
+};
+
+WebDomMutationObserver* WebDomMutationObserver::Create(
+    const WebDocument& document,
+    WebDomMutationObserver::Callback callback) {
+  Document* core_document = document;
+  // A document with no execution context cannot activate a MutationObserver.
+  // That is the initial empty document of a window.open, not a loaded page,
+  // and returning null is the honest answer rather than CHECKing — a CHECK
+  // here crashes the renderer the moment a page opens a popup.
+  if (!core_document || !core_document->GetExecutionContext()) {
+    return nullptr;
+  }
+  return MakeGarbageCollected<WebDomMutationObserverImpl>(
+      base::PassKey<WebDomMutationObserver>(), *core_document,
+      std::move(callback));
+}
+
+WebDomMutationObserverImpl::WebDomMutationObserverImpl(
+    base::PassKey<WebDomMutationObserver>,
+    Document& document,
+    WebDomMutationObserver::Callback callback) {
+  mutation_callback_ =
+      MakeGarbageCollected<ObserverCallback>(document, std::move(callback));
+}
+
+WebDomMutationObserverImpl::~WebDomMutationObserverImpl() = default;
+
+void WebDomMutationObserverImpl::Disconnect() {
+  if (mutation_callback_) {
+    mutation_callback_->Disconnect();
+    mutation_callback_ = nullptr;
+  }
+  self_keep_alive_.Clear();
+}
+
+void WebDomMutationObserverImpl::FlushPending() {
+  if (mutation_callback_) {
+    mutation_callback_->FlushPending();
+  }
+}
+
+void WebDomMutationObserverImpl::Trace(Visitor* visitor) const {
+  visitor->Trace(mutation_callback_);
+}
+
+}  // namespace blink

+#define THIRD_PARTY_BLINK_RENDERER_CORE_EXPORTED_WEB_DOM_MUTATION_OBSERVER_IMPL_H_
+
+#include "base/types/pass_key.h"
+#include "third_party/blink/public/web/web_dom_mutation_observer.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/heap/self_keep_alive.h"
+
+namespace blink {
+
+class Document;
+
+class CORE_EXPORT WebDomMutationObserverImpl final
+    : public GarbageCollected<WebDomMutationObserverImpl>,
+      public WebDomMutationObserver {
+ public:
+  WebDomMutationObserverImpl(base::PassKey<WebDomMutationObserver>,
+                             Document&,
+                             WebDomMutationObserver::Callback);
+  WebDomMutationObserverImpl(const WebDomMutationObserverImpl&) = delete;
+  WebDomMutationObserverImpl& operator=(const WebDomMutationObserverImpl&) =
+      delete;
+  ~WebDomMutationObserverImpl() override;
+
+  // WebDomMutationObserver implementation.
+  void Disconnect() override;
+  void FlushPending() override;
+
+  void Trace(Visitor*) const;
+
+ private:
+  class ObserverCallback;
+
+  Member<ObserverCallback> mutation_callback_;
+
+  // WebDomMutationObserverImpl must remain alive until Disconnect() is called.
+  SelfKeepAlive<WebDomMutationObserverImpl> self_keep_alive_{this};
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EXPORTED_WEB_DOM_MUTATION_OBSERVER_IMPL_H_

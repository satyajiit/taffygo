From 2c3453e6e8ce95951706ecc0041b1e5d3ed25395 Mon Sep 17 00:00:00 2001
From: Matterward Labs <admin@matterwardlabs.com>
Date: Sun, 6 Sep 2026 19:07:10 +0530
Subject: give the renderer the filtering request filter

The cosmetic-filter render frame observer needs to ask the browser what a
frame's origin is allowed to load. Bind taffy::filtering::mojom::RequestFilter
on each render process host, and carry a pending remote through
URLLoaderThrottleProviderImpl so a renderer-side throttle can reach it without
a synchronous hop.

The remote is per-provider and cloned on demand: the throttle provider is
copied for each worker, and a bound Remote cannot be shared across sequences.

Specified by
chromium/patches/0046-give-the-renderer-the-filtering-request-filter.md.

Taffy-Patch: 0046

diff --git a/chrome/browser/chrome_content_browser_client_receiver_bindings.cc b/chrome/browser/chrome_content_browser_client_receiver_bindings.cc
index 6cf53712f067f..1903d8d14a57e 100644
--- a/chrome/browser/chrome_content_browser_client_receiver_bindings.cc
+++ b/chrome/browser/chrome_content_browser_client_receiver_bindings.cc
@@ -14,6 +14,7 @@
 #include "chrome/browser/chrome_content_browser_client.h"
 #include "chrome/browser/chrome_content_browser_client_parts.h"
 #include "taffy/browser/cosmetic_filter_bindings.h"
+#include "taffy/browser/filtering_request_filter.h"
 #include "chrome/browser/content_settings/content_settings_manager_delegate.h"
 #include "chrome/browser/headless/headless_mode_util.h"
 #include "chrome/browser/net/net_error_tab_helper.h"
@@ -221,6 +222,11 @@ void ChromeContentBrowserClient::ExposeInterfacesToRenderer(
   registry->AddInterface<metrics::mojom::CallStackProfileCollector>(
       base::BindRepeating(&metrics::CallStackProfileCollector::Create));
 
+  registry->AddInterface<taffy::filtering::mojom::RequestFilter>(
+      base::BindRepeating(&taffy::BindFilteringRequestFilter,
+                          render_process_host->GetDeprecatedID()),
+      ui_task_runner);
+
   if (NetBenchmarking::CheckBenchmarkingEnabled()) {
     Profile* profile =
         Profile::FromBrowserContext(render_process_host->GetBrowserContext());

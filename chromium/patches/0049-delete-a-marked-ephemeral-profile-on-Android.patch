+TEST_P(ProfileManagerTest, DeletesOnlyExactMarkedHiddenEphemeralProfile) {
+  base::ScopedPathOverride user_data_override(chrome::DIR_USER_DATA,
+                                              temp_dir_.GetPath());
+  const base::FilePath cache_root =
+      temp_dir_.GetPath().AppendASCII("ExactCacheRoot");
+  base::ScopedPathOverride cache_override(base::DIR_CACHE, cache_root,
+                                          /*is_absolute=*/true,
+                                          /*create=*/true);
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  Profile* active_profile =
+      AddProfileToStorage(profile_manager, "Active", u"Active");
+  Profile* candidate_profile =
+      AddProfileToStorage(profile_manager, "Profile 17", u"Candidate");
+  ASSERT_TRUE(active_profile);
+  ASSERT_TRUE(candidate_profile);
+  profile_manager->SetProfileAsLastUsed(active_profile);
+
+  const base::FilePath candidate_path = candidate_profile->GetPath();
+  ProfileAttributesEntry* candidate_entry =
+      profile_manager->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(candidate_path);
+  ASSERT_TRUE(candidate_entry);
+  candidate_entry->SetIsEphemeral(true);
+  candidate_entry->SetIsOmitted(true);
+
+  base::MockCallback<base::OnceCallback<void(bool)>> rejected;
+  EXPECT_CALL(rejected, Run).Times(0);
+  EXPECT_FALSE(profile_manager->DeleteMarkedEphemeralProfileOnAndroid(
+      candidate_path, rejected.Get()));
+
+  ASSERT_TRUE(ScheduleProfileDirectoryForDeletion(candidate_path));
+  ASSERT_TRUE(PersistProfileDirectoryDeletionMarker(candidate_path));
+  EXPECT_FALSE(IsProfileDirectoryMarkedForDeletion(candidate_path));
+  ASSERT_TRUE(ArmProfileDirectoryForDeletion(candidate_path));
+  EXPECT_TRUE(IsProfileDirectoryMarkedForDedicatedDeletion(candidate_path));
+  ASSERT_TRUE(IsProfileDirectoryMarkedForDeletion(candidate_path));
+
+  const base::FilePath candidate_cache =
+      cache_root.Append(candidate_path.BaseName());
+  const base::FilePath cache_sentinel = cache_root.AppendASCII("keep");
+  ASSERT_TRUE(base::CreateDirectory(candidate_cache));
+  ASSERT_TRUE(base::WriteFile(cache_sentinel, "keep"));
+
+  bool deletion_result = false;
+  base::RunLoop deletion;
+  ASSERT_TRUE(profile_manager->DeleteMarkedEphemeralProfileOnAndroid(
+      candidate_path, base::BindLambdaForTesting([&](bool deleted) {
+        deletion_result = deleted;
+        deletion.Quit();
+      })));
+  deletion.Run();
+
+  EXPECT_TRUE(deletion_result);
+  EXPECT_EQ(nullptr, profile_manager->GetProfileByPath(candidate_path));
+  EXPECT_EQ(nullptr, profile_manager->GetProfileAttributesStorage()
+                         .GetProfileAttributesWithPath(candidate_path));
+  EXPECT_FALSE(base::PathExists(candidate_path));
+  EXPECT_FALSE(base::PathExists(candidate_cache));
+  EXPECT_TRUE(base::PathExists(cache_root));
+  EXPECT_TRUE(base::PathExists(cache_sentinel));
+  EXPECT_FALSE(IsProfileDirectoryMarkedForDeletion(candidate_path));
+  EXPECT_TRUE(profile_manager->IsValidProfile(active_profile));
+  EXPECT_EQ(active_profile->GetPath(),
+            profile_manager->GetLastUsedProfileDir());
+  EXPECT_TRUE(g_browser_process->local_state()
+                  ->GetList(prefs::kProfilesDeleted)
+                  .empty());
+}

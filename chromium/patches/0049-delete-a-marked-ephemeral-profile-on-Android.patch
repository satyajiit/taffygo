+void FinishMarkedProfileDeletionOnAndroid(
+    base::FilePath profile_path,
+    base::OnceCallback<void(bool)> completion,
+    bool deleted) {
+  const bool completed =
+      deleted && CompleteProfileDirectoryDeletionMarker(profile_path);
+  if (completion) {
+    std::move(completion).Run(completed);
+  }
+}
+
+void PostMarkedProfileDeletionOnAndroid(
+    const base::FilePath& profile_path,
+    base::OnceCallback<void(bool)> completion) {
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&NukeProfileFromDiskWithResult, profile_path,
+                     base::BindOnce(&FinishMarkedProfileDeletionOnAndroid,
+                                    profile_path, std::move(completion))));
+}

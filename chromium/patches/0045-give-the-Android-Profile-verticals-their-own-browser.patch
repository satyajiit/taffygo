From 9130ed1711ee86fd5c4d5f3c7703225a73065022 Mon Sep 17 00:00:00 2001
From: Matterward Labs <admin@matterwardlabs.com>
Date: Sun, 6 Sep 2026 19:06:59 +0530
Subject: give the Android Profile verticals their own browser-test binary

The Profile acceptance verticals need Chrome's shipping Profile, its
utility-service registry and Android's browser-test process setup, but none
of the thousands of unrelated cases or data roots android_browsertests
carries. Declare taffy_profile_browsertests as its own test() so its runtime
payload has one owner.

Register the suite with the instrumentation runner the same way
taffy_browsertests is: content::BrowserTestBase requires one fresh Android
process per test, so the suite needs the one-test shard limit and the
wildcard-expansion path that avoids BrowserTestBase's process-reuse CHECK.

Specified by chromium/patches/0045-register-taffy-profile-browsertests.md.

Taffy-Patch: 0045

diff --git a/build/android/pylib/gtest/gtest_test_instance.py b/build/android/pylib/gtest/gtest_test_instance.py
index 5fb3f5d433429..437eb9be62c21 100644
--- a/build/android/pylib/gtest/gtest_test_instance.py
+++ b/build/android/pylib/gtest/gtest_test_instance.py
@@ -32,6 +32,7 @@ BROWSER_TEST_SUITES = [
     'components_browsertests',
     'content_browsertests',
     'taffy_browsertests',
+    'taffy_profile_browsertests',
 ]
 
 # The max number of tests to run on a batch during the test run.
diff --git a/build/android/pylib/local/device/local_device_gtest_run_test.py b/build/android/pylib/local/device/local_device_gtest_run_test.py
index 2a6b43c9e41d9..ed68653c30a96 100755
--- a/build/android/pylib/local/device/local_device_gtest_run_test.py
+++ b/build/android/pylib/local/device/local_device_gtest_run_test.py
@@ -61,7 +61,9 @@ class LocalDeviceGtestRunTest(unittest.TestCase):
   def testGetTestsFromFiltersBrowserWildcardNeedsEnumeration(self):
     self._obj._test_instance.extract_test_list_from_filter = True
     self._obj._test_instance.gtest_filters = ['TestSuite.*']
-    for suite in ('android_browsertests', 'taffy_browsertests'):
+    for suite in (
+        'android_browsertests', 'taffy_browsertests',
+        'taffy_profile_browsertests'):
       with self.subTest(suite=suite):
         self._obj._test_instance.suite = suite
         self.assertIsNone(self._obj._GetTestsFromFilters())

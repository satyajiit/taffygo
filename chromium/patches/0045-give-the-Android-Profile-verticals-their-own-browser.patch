+  # TaffyGo's Profile acceptance verticals need Chrome's shipping Profile,
+  # utility-service registry, and Android browser-test process setup, but none
+  # of the thousands of unrelated cases or data roots in android_browsertests.
+  # Keep this as its own binary so its runtime payload has one owner.
+  test("taffy_profile_browsertests") {
+    configs += [ "//build/config:precompiled_headers" ]
+    configs += [ "//build/config/compiler:no_exit_time_destructors" ]
+    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
+    use_default_launcher = false
+    product_config_java_packages = [ "org.chromium.chrome.browser" ]
+    android_manifest =
+        "${target_gen_dir}/taffy_profile_browsertests_manifest/AndroidManifest.xml"
+    android_manifest_dep = ":taffy_profile_browsertests_manifest"
+
+    loadable_modules = [ "$root_out_dir/libcrashpad_handler_trampoline.so" ]
+
+    if (!is_java_debug) {
+      proguard_enabled = true
+      proguard_configs = [ "//chrome/android/proguard/main.flags" ]
+    }
+
+    sources =
+        [ "android/browsertests_apk/android_browsertests_jni_onload.cc" ]
+
+    deps = [
+      ":android_browsertests_assets",
+      ":android_browsertests_java",
+      ":browser_tests_runner",
+      ":test_support",
+      ":test_support_ui_android",
+      "//base",
+      "//chrome:chrome_android_core",
+      "//chrome/android:chrome_jni_headers",
+      "//chrome/android:delegate_public_impl_java",
+      "//chrome/browser:chrome_content_browser_client",
+      "//chrome/browser/android",
+      "//chrome/browser/profiles",
+      "//components/gcm_driver/instance_id/android:instance_id_driver_test_support_java",
+      "//content/shell:content_shell_lib",
+      "//content/test:android_test_message_pump_support",
+      "//taffy/test/recovery:core_service_recovery_browser_tests",
+      "//taffy/test/android/profile:task_pdf_handoff_java",
+      "//testing/android/native_test:native_test_support",
+      "//third_party/crashpad/crashpad/handler:crashpad_handler_trampoline",
+    ]
+
+    data = [
+      "//chrome/test/data/title1.html",
+      "//chrome/test/data/title2.html",
+    ]
+  }
+
   test("android_sync_integration_tests") {
     use_default_launcher = false
     android_manifest = "${target_gen_dir}/android_sync_integration_tests_manifest/AndroidManifest.xml"
@@ -1937,6 +1988,17 @@ if (is_android) {
     ]
   }
 
+  jinja_template("taffy_profile_browsertests_manifest") {
+    testonly = true
+    input = "//taffy/test/recovery/AndroidManifest.xml.jinja2"
+    includes = [ "//chrome/test/android/browsertests_apk/AndroidManifest.xml.jinja2" ]
+    output = "${target_gen_dir}/taffy_profile_browsertests_manifest/AndroidManifest.xml"
+    variables = [
+      "manifest_package=org.chromium.android_browsertests_apk",
+      "library_name=taffy_profile_browsertests__library",
+    ]
+  }
+
   jinja_template("android_sync_integration_tests_manifest") {
     testonly = true
     input = "//chrome/test/android/browsertests_apk/AndroidManifest.xml.jinja2"
diff --git a/chrome/test/android/browsertests_apk/AndroidManifest.xml.jinja2 b/chrome/test/android/browsertests_apk/AndroidManifest.xml.jinja2

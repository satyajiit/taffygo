+#if BUILDFLAG(IS_ANDROID)
+bool ProfileManager::DeleteProfileOnAndroid(
+    const base::FilePath& profile_path,
+    base::OnceClosure completion,
+    ProfileMetrics::ProfileDelete deletion_source) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+
+  ProfileAttributesStorage& storage = GetProfileAttributesStorage();
+  ProfileAttributesEntry* entry =
+      storage.GetProfileAttributesWithPath(profile_path);
+  if (!entry || !IsAllowedProfilePath(profile_path) ||
+      profile_path == GetGuestProfilePath() || entry->IsOmitted() ||
+      entry->IsEphemeral() || profile_path == GetLastUsedProfileDir() ||
+      IsProfileDirectoryMarkedForDeletion(profile_path)) {
+    return false;
+  }
+
+  size_t regular_profile_count = 0;
+  for (ProfileAttributesEntry* candidate : storage.GetAllProfilesAttributes()) {
+    if (candidate && IsAllowedProfilePath(candidate->GetPath()) &&
+        candidate->GetPath() != GetGuestProfilePath() &&
+        !candidate->IsOmitted() && !candidate->IsEphemeral() &&
+        !IsProfileDirectoryMarkedForDeletion(candidate->GetPath())) {
+      ++regular_profile_count;
+    }
+  }
+  ProfileInfo* info = GetProfileInfoByPath(profile_path);
+  if (regular_profile_count <= 1 || (info && !info->GetCreatedProfile()) ||
+      !ScheduleProfileDirectoryForDeletion(profile_path)) {
+    return false;
+  }
+
+  ProfileMetrics::LogProfileDeleteUser(deletion_source);
+  MarkProfileDirectoryForDeletion(profile_path);
+
+  auto nuke_profile = base::BindOnce(
+      &PostProfileDeletionOnAndroid, profile_path,
+      base::FilePathToValue(profile_path.BaseName()), std::move(completion));
+
+  if (Profile* profile = GetProfileByPath(profile_path)) {
+    NotifyOnProfileMarkedForPermanentDeletion(profile);
+    profile->GetPrefs()->OnStoreDeletionFromDisk();
+    profiles_pending_destruction_[profile_path].push_back(
+        std::move(nuke_profile));
+    storage.RemoveProfile(profile_path);
+    profiles_info_.erase(profile_path);
+  } else {
+    storage.RemoveProfile(profile_path);
+    std::move(nuke_profile).Run();
+  }
+  return true;
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+

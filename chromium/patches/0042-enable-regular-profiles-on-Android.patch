+#if BUILDFLAG(IS_ANDROID)
+void FinishProfileDeletionOnAndroid(base::Value profile_path_value,
+                                    base::OnceClosure completion) {
+  if (g_browser_process && !g_browser_process->IsShuttingDown()) {
+    ScopedListPrefUpdate deleted_profiles(g_browser_process->local_state(),
+                                          prefs::kProfilesDeleted);
+    deleted_profiles->EraseValue(profile_path_value);
+  }
+  if (completion) {
+    std::move(completion).Run();
+  }
+}
+
+void PostProfileDeletionOnAndroid(const base::FilePath& profile_path,
+                                  base::Value profile_path_value,
+                                  base::OnceClosure completion) {
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&NukeProfileFromDisk, profile_path,
+                     base::BindOnce(&FinishProfileDeletionOnAndroid,
+                                    std::move(profile_path_value),
+                                    std::move(completion))));
+}
+
+void CleanUpDeletedProfilesOnAndroid(ProfileManager& manager) {
+  PrefService* local_state = g_browser_process->local_state();
+  ProfileAttributesStorage& storage = manager.GetProfileAttributesStorage();
+  base::ListValue deleted_profiles =
+      local_state->GetList(prefs::kProfilesDeleted).Clone();
+  for (base::Value& value : deleted_profiles) {
+    std::optional<base::FilePath> relative_path = base::ValueToFilePath(value);
+    const bool safe_name = relative_path && !relative_path->empty() &&
+                           !relative_path->IsAbsolute() &&
+                           relative_path->BaseName() == *relative_path &&
+                           relative_path->value() != FILE_PATH_LITERAL(".") &&
+                           relative_path->value() != FILE_PATH_LITERAL("..");
+    if (safe_name) {
+      const base::FilePath profile_path =
+          manager.user_data_dir().Append(*relative_path);
+      ProfileAttributesEntry* entry =
+          storage.GetProfileAttributesWithPath(profile_path);
+      const bool interrupted_deletion =
+          !entry || (entry->IsEphemeral() && entry->IsOmitted());
+      if (profile_path.DirName() == manager.user_data_dir() &&
+          interrupted_deletion) {
+        if (entry) {
+          storage.RemoveProfile(profile_path);
+        }
+        PostProfileDeletionOnAndroid(profile_path, std::move(value),
+                                     base::OnceClosure());
+        continue;
+      }
+    }
+    FinishProfileDeletionOnAndroid(std::move(value), base::OnceClosure());
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+
 }  // namespace
 

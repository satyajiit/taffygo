diff --git a/chrome/browser/profiles/profile_manager_unittest.cc b/chrome/browser/profiles/profile_manager_unittest.cc
index 2f54f7236a311..c8b5b6ca8c25a 100644
--- a/chrome/browser/profiles/profile_manager_unittest.cc
+++ b/chrome/browser/profiles/profile_manager_unittest.cc
@@ -434,6 +434,41 @@ TEST_P(ProfileManagerTest, DefaultProfileDir) {
             ProfileManager::GetInitialProfileDir().value());
 }
 
+#if BUILDFLAG(IS_ANDROID)
+TEST_P(ProfileManagerTest, DeletesOnlyInactiveRegularProfileOnAndroid) {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  Profile* active_profile =
+      AddProfileToStorage(profile_manager, "Active", u"Active");
+  Profile* inactive_profile =
+      AddProfileToStorage(profile_manager, "Inactive", u"Inactive");
+  ASSERT_TRUE(active_profile);
+  ASSERT_TRUE(inactive_profile);
+  profile_manager->SetProfileAsLastUsed(active_profile);
+
+  bool rejected_completion_called = false;
+  EXPECT_FALSE(profile_manager->DeleteProfileOnAndroid(
+      active_profile->GetPath(),
+      base::BindLambdaForTesting(
+          [&rejected_completion_called] { rejected_completion_called = true; }),
+      ProfileMetrics::DELETE_PROFILE_SETTINGS));
+  content::RunAllTasksUntilIdle();
+  EXPECT_FALSE(rejected_completion_called);
+
+  const base::FilePath inactive_path = inactive_profile->GetPath();
+  base::RunLoop deletion;
+  ASSERT_TRUE(profile_manager->DeleteProfileOnAndroid(
+      inactive_path, deletion.QuitClosure(),
+      ProfileMetrics::DELETE_PROFILE_SETTINGS));
+  deletion.Run();
+
+  EXPECT_EQ(nullptr, profile_manager->GetProfileByPath(inactive_path));
+  EXPECT_EQ(nullptr, profile_manager->GetProfileAttributesStorage()
+                         .GetProfileAttributesWithPath(inactive_path));
+  EXPECT_FALSE(base::PathExists(inactive_path));
+  EXPECT_TRUE(profile_manager->IsValidProfile(active_profile));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+

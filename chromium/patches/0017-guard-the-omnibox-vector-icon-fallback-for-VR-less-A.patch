From 3ae919ce8e39e20bf86f19d4b347dc10b5e45dfa Mon Sep 17 00:00:00 2001
From: Matterward Labs <admin@matterwardlabs.com>
Date: Tue, 18 Aug 2026 03:02:07 +0530
Subject: guard the omnibox vector-icon fallback for VR-less Android

AutocompleteMatch::GetVectorIcon is declared only under
(!IS_ANDROID || ENABLE_VR) && !IS_IOS, but GetMatchIcon's fallback calls it
unguarded, so an Android build with the XR runtimes disabled does not
compile. Mirror the declaration's guard at the call site and return the
empty image on the excluded configuration, the same value the favicon path
produces while a fetch is outstanding.

Taffy-Patch: 0017

diff --git a/chrome/browser/ui/omnibox/omnibox_edit_model.cc b/chrome/browser/ui/omnibox/omnibox_edit_model.cc
index ed78b9d69257b..36716818b9dc2 100644
--- a/chrome/browser/ui/omnibox/omnibox_edit_model.cc
+++ b/chrome/browser/ui/omnibox/omnibox_edit_model.cc
@@ -30,6 +30,7 @@
 #include "base/trace_event/typed_macros.h"
 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
+#include "components/omnibox/browser/buildflags.h"
 #include "chrome/app/vector_icons/vector_icons.h"
 #include "chrome/browser/contextual_search/contextual_search_service_factory.h"
 #include "chrome/browser/contextual_search/contextual_search_web_contents_helper.h"
@@ -1939,11 +1940,18 @@ gfx::Image OmniboxEditModel::GetMatchIcon(const AutocompleteMatch& match,
     }
   }
 
+  // Taffy: the declaration of GetVectorIcon carries this same guard; the
+  // call did not, so an Android build without ENABLE_VR failed to compile.
+  // chromium/patches/0017-guard-omnibox-vector-icon-fallback-for-vr-less-android.md
+#if !BUILDFLAG(IS_ANDROID) || BUILDFLAG(ENABLE_VR)
   bool is_starred_match = IsStarredMatch(match);
   const auto& vector_icon_type = match.GetVectorIcon(is_starred_match, turl);
 
   return controller_->client()->GetSizedIcon(vector_icon_type,
                                              vector_icon_color);
+#else
+  return gfx::Image();
+#endif
 }
 

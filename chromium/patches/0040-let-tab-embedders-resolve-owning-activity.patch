+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tab;
+
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import android.app.Activity;
+
+import androidx.test.filters.SmallTest;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.lang.ref.WeakReference;
+
+/** Tests for the Activity projection used by external-navigation interception. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class InterceptNavigationDelegateClientImplUnitTest {
+    private TabImpl mTab;
+    private WindowAndroid mWindow;
+    private InterceptNavigationDelegateClientImpl mClient;
+
+    @Before
+    public void setUp() {
+        mTab = mock(TabImpl.class);
+        mWindow = mock(WindowAndroid.class);
+        when(mTab.getWindowAndroid()).thenReturn(mWindow);
+        mClient = new InterceptNavigationDelegateClientImpl(mTab);
+    }
+
+    @Test
+    @SmallTest
+    public void getActivityPrefersChromeActivityOwnedByTab() {
+        ChromeActivity chromeActivity = mock(ChromeActivity.class);
+        Activity windowActivity = mock(Activity.class);
+        when(mTab.getActivity()).thenReturn(chromeActivity);
+        when(mWindow.getActivity()).thenReturn(new WeakReference<>(windowActivity));
+
+        assertSame(chromeActivity, mClient.getActivity());
+    }
+
+    @Test
+    @SmallTest
+    public void getActivityFallsBackToOwningWindow() {
+        Activity windowActivity = mock(Activity.class);
+        when(mTab.getActivity()).thenReturn(null);
+        when(mWindow.getActivity()).thenReturn(new WeakReference<>(windowActivity));
+
+        assertSame(windowActivity, mClient.getActivity());
+    }
+
+    @Test
+    @SmallTest
+    public void getActivityReturnsNullForDetachedTab() {
+        when(mTab.getActivity()).thenReturn(null);
+        when(mTab.getWindowAndroid()).thenReturn(null);
+
+        assertNull(mClient.getActivity());
+    }
+
+    @Test
+    @SmallTest
+    public void getActivityReturnsNullWhenWindowOwnerIsGone() {
+        when(mTab.getActivity()).thenReturn(null);
+        when(mWindow.getActivity()).thenReturn(new WeakReference<>(null));
+
+        assertNull(mClient.getActivity());
+    }
+}

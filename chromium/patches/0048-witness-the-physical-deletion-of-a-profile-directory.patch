+#if BUILDFLAG(IS_ANDROID)
+  base::FilePath user_data_dir;
+  base::FilePath shared_cache_root;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir) ||
+      !base::PathService::Get(base::DIR_CACHE, &shared_cache_root)) {
+    return false;
+  }
+  if (profile_path.DirName() != user_data_dir ||
+      !IsGeneratedRegularProfileBaseName(profile_path.BaseName())) {
+    // Never infer exact cache custody for redirected paths, and never
+    // substitute Android's shared cache root for Default.
+    return false;
+  }
+  const base::FilePath expected_cache_path =
+      shared_cache_root.Append(profile_path.BaseName());
+  chrome::GetUserCacheDirectory(profile_path, cache_path);
+  // A disabled or changed cache-isolation mapping must fail closed rather
+  // than turn the shared application cache directory into deletion custody.
+  return *cache_path == expected_cache_path &&
+         *cache_path != shared_cache_root && *cache_path != profile_path;
+#else

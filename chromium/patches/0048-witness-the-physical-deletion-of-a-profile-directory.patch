+
+void FinishResultBearingNuke(const base::FilePath& profile_path,
+                             base::OnceCallback<void(bool)> callback,
+                             bool success) {
+  // The callback settles this physical attempt regardless of its outcome.
+  // Keeping a volatile strict mark after false would let shutdown replay the
+  // operation without fresh authority. Its durable marker remains untouched.
+  const auto marked = ProfilesToDelete().find(profile_path);
+  if (marked != ProfilesToDelete().end() &&
+      marked->second == ProfileDeletionStage::MARKED_WITH_DEDICATED_CACHE) {
+    ProfilesToDelete().erase(marked);
+  }
+  if (callback) {
+    std::move(callback).Run(success);
+  }

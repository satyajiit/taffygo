+
+bool SyncOpenedDirectory(const base::File& directory,
+                         const base::FilePath& path) {
+#if BUILDFLAG(IS_POSIX)
+  base::stat_wrapper_t held = {};
+  base::stat_wrapper_t named = {};
+  if (!directory.IsValid() ||
+      base::File::Fstat(directory.GetPlatformFile(), &held) != 0 ||
+      base::File::Lstat(path, &named) != 0 || !S_ISDIR(held.st_mode) ||
+      !S_ISDIR(named.st_mode) || held.st_dev != named.st_dev ||
+      held.st_ino != named.st_ino || held.st_nlink == 0 ||
+      named.st_nlink == 0 ||
+      HANDLE_EINTR(fsync(directory.GetPlatformFile())) != 0) {
+    return false;
+  }
+  named = {};
+  return base::File::Lstat(path, &named) == 0 && S_ISDIR(named.st_mode) &&
+         held.st_dev == named.st_dev && held.st_ino == named.st_ino &&
+         named.st_nlink > 0;
+#else

@@ -0,0 +1,78 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.download;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnit;
+import org.mockito.junit.MockitoRule;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Unit tests for the embedder-owned notification seam in {@link DownloadManagerService}. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public final class DownloadManagerServiceUnitTest {
+    @Rule public final MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private DownloadNotifier mDownloadNotifier;
+    @Mock private DownloadManagerService mDownloadManagerService;
+    @Mock private DownloadManagerService.DownloadNotifierFactory mFactory;
+
+    @Before
+    public void setUp() {
+        DownloadManagerService.setDownloadManagerService(null);
+    }
+
+    @After
+    public void tearDown() {
+        DownloadManagerService.setDownloadManagerService(null);
+    }
+
+    @Test
+    public void createDownloadNotifier_withoutFactory_keepsSystemDefault() {
+        assertTrue(
+                DownloadManagerService.createDownloadNotifier() instanceof SystemDownloadNotifier);
+    }
+
+    @Test
+    public void createDownloadNotifier_withFactory_usesExactEmbedderNotifier() {
+        when(mFactory.create()).thenReturn(mDownloadNotifier);
+
+        assertTrue(DownloadManagerService.installDownloadNotifierFactory(mFactory));
+
+        assertSame(mDownloadNotifier, DownloadManagerService.createDownloadNotifier());
+        verify(mFactory).create();
+    }
+
+    @Test
+    public void installDownloadNotifierFactory_secondOwnerIsRejected() {
+        assertTrue(DownloadManagerService.installDownloadNotifierFactory(mFactory));
+
+        assertFalse(DownloadManagerService.installDownloadNotifierFactory(mFactory));
+    }
+
+    @Test
+    public void installDownloadNotifierFactory_afterSingleton_isRejected() {
+        DownloadManagerService.setDownloadManagerService(mDownloadManagerService);
+
+        assertFalse(DownloadManagerService.installDownloadNotifierFactory(mFactory));
+
+        verify(mFactory, never()).create();
+        assertSame(mDownloadManagerService, DownloadManagerService.getDownloadManagerService());
+    }
+}

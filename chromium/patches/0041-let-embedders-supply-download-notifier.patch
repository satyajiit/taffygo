From 9e72b50fc2574ebe3541a280fbbe6062ed84478a Mon Sep 17 00:00:00 2001
From: Matterward Labs <admin@matterwardlabs.com>
Date: Tue, 1 Sep 2026 06:37:52 +0530
Subject: let embedders supply download notifier

Allow an embedder to install the process-wide presentation sink before the download-manager singleton is created, while preserving Chromium's system notifier as the default.

Specified by chromium/patches/0041-let-embedders-supply-download-notifier.md.

Taffy-Patch: 0041

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadManagerService.java b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadManagerService.java
index 32ab73c09f15f..be7d65fccec1a 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadManagerService.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadManagerService.java
@@ -93,6 +93,7 @@ public class DownloadManagerService implements DownloadServiceDelegate, ProfileM
     private static final Set<String> sFirstSeenDownloadIds = new HashSet<>();
 
     private static @Nullable DownloadManagerService sDownloadManagerService;
+    private static @Nullable DownloadNotifierFactory sDownloadNotifierFactory;
     private static boolean sIsNetworkListenerDisabled;
     private static boolean sIsNetworkMetered;
 
@@ -134,6 +135,11 @@ public class DownloadManagerService implements DownloadServiceDelegate, ProfileM
     private boolean mIsUiUpdateScheduled;
     private @Nullable DownloadManagerRequestInterceptor mDownloadManagerRequestInterceptor;
 
+    /** Creates the presentation sink used by the process-wide download manager. */
+    public interface DownloadNotifierFactory {
+        DownloadNotifier create();
+    }
+
     /**
      * Interface to intercept download request to Android DownloadManager. This is implemented by
      * tests so that we don't need to actually enqueue a download into the Android DownloadManager.
@@ -171,14 +177,38 @@ public class DownloadManagerService implements DownloadServiceDelegate, ProfileM
     public static DownloadManagerService getDownloadManagerService() {
         ThreadUtils.assertOnUiThread();
         if (sDownloadManagerService == null) {
-            DownloadNotifier downloadNotifier = new SystemDownloadNotifier();
             sDownloadManagerService =
                     new DownloadManagerService(
-                            downloadNotifier, new Handler(), UPDATE_DELAY_MILLIS);
+                            createDownloadNotifier(), new Handler(), UPDATE_DELAY_MILLIS);
         }
         return sDownloadManagerService;
     }
 
+    /**
+     * Installs the notifier factory used when the singleton is first created.
+     *
+     * <p>The factory cannot replace another embedder factory or a notifier already owned by a live
+     * service. Callers must install it during process initialization, before any download code can
+     * obtain the singleton.
+     *
+     * @return Whether the factory was installed.
+     */
+    public static boolean installDownloadNotifierFactory(DownloadNotifierFactory factory) {
+        ThreadUtils.assertOnUiThread();
+        if (sDownloadManagerService != null || sDownloadNotifierFactory != null) return false;
+
+        sDownloadNotifierFactory = factory;
+        ResettersForTesting.register(() -> sDownloadNotifierFactory = null);
+        return true;
+    }
+
+    @VisibleForTesting
+    static DownloadNotifier createDownloadNotifier() {
+        return sDownloadNotifierFactory == null
+                ? new SystemDownloadNotifier()
+                : assertNonNull(sDownloadNotifierFactory.create());
+    }
+
     public static boolean hasDownloadManagerService() {
         ThreadUtils.assertOnUiThread();
         return sDownloadManagerService != null;

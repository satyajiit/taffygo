+                        (Intent) any(), (WindowAndroid.IntentCallback) any(), anyInt()))
+                .thenReturn(true);
+        selectFileDialog.selectFile(
+                intentAction,
+                new String[] {"application/pdf"},
+                /* capture= */ false,
+                /* multiple= */ false,
+                /* defaultDirectory= */ null,
+                /* suggestedName= */ null,
+                windowAndroid);
+        return selectFileDialog;
+    }

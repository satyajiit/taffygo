+    @Test
+    @EnableFeatures({UiAndroidFeatures.SELECT_FILE_OPEN_DOCUMENT})
+    public void testGetContentResultDoesNotPersistPermission() throws Exception {
+        ContentResolver contentResolver = installMockContentResolver();
+        TestSelectFileDialog selectFileDialog = prepareResultTest(Intent.ACTION_GET_CONTENT);
+        Uri selectedUri = Uri.parse("content://provider/transient");
+        Intent result =
+                new Intent()
+                        .setData(selectedUri)
+                        .addFlags(
+                                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+
+        selectFileDialog.onIntentCompleted(Activity.RESULT_OK, result);
+
+        Mockito.verify(contentResolver, Mockito.never())
+                .takePersistableUriPermission(any(), anyInt());
+        runAllAsyncTasks();
+    }
+
+    @Test
+    @EnableFeatures({UiAndroidFeatures.SELECT_FILE_OPEN_DOCUMENT})
+    public void testOpenDocumentPersistsOnlyReturnedModes() throws Exception {
+        ContentResolver contentResolver = installMockContentResolver();
+        TestSelectFileDialog selectFileDialog = prepareResultTest(Intent.ACTION_OPEN_DOCUMENT);
+        Uri selectedUri = Uri.parse("content://provider/persistable");
+        Intent result =
+                new Intent()
+                        .setData(selectedUri)
+                        .addFlags(
+                                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+
+        selectFileDialog.onIntentCompleted(Activity.RESULT_OK, result);
+
+        Mockito.verify(contentResolver)
+                .takePersistableUriPermission(selectedUri, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        Mockito.verify(contentResolver, Mockito.never())
+                .takePersistableUriPermission(selectedUri, Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        runAllAsyncTasks();
+    }
+
+    private ContentResolver installMockContentResolver() {
+        Context context = Mockito.spy(ContextUtils.getApplicationContext());
+        ContentResolver contentResolver = Mockito.mock(ContentResolver.class);
+        when(context.getContentResolver()).thenReturn(contentResolver);
+        ContextUtils.initApplicationContextForTests(context);
+        return contentResolver;
+    }
+
+    private TestSelectFileDialog prepareResultTest(String intentAction) {
+        TestSelectFileDialog selectFileDialog = new TestSelectFileDialog(0);
+        WindowAndroid windowAndroid = Mockito.mock(WindowAndroid.class);

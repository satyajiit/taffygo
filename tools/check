# --- device lane ------------------------------------------------------------
#
# The four suites this lane is responsible for, in the order it builds and runs
# them. The list is here rather than inline because the evidence record reports
# one row per suite whether or not the lane ever reached it, and two copies of
# the list is how a suite comes to be run and not reported, or reported and not
# run.
# `taffy_profile_browsertests` is the fifth and it is not like the other four:
# patch 0045 declares it in //chrome/test/BUILD.gn rather than under
# taffy-core/, because Chrome owns the Profile-scoped browser-test runner. It
# is the only binary that compiles taffy-core/test/recovery/ and the Task
# Benchmark probes beside it, and until it was named here no repository command
# built it at all — twenty-two sources whose only referrer is a numbered patch.
DEVICE_SUITE_TARGETS='taffy_unittests taffy_browsertests taffy_public_test_apk taffy_shell_junit_tests taffy_profile_browsertests'

DEVICE_ADB=''
DEVICE_TARGET=''
DEVICE_ABI=''
DEVICE_PROFILE_USED=''
DEVICE_COMMAND='./tools/check device'

# The evidence record.
#
# The lane refuses to report a suite it did not run. It should refuse just as
# firmly to leave no trace of what it did observe, which is what this record is
# for: every path out of the lane — including the ones that stop before a build
# — writes one, naming the host, the command, the target it selected, the state
# each declared suite actually reached, and the lane's own findings verbatim.
#
# It follows the convention of tools/benchmark.d/evidence.py: an
# `evidence_version`, a UTC `generated_at`, the host, what was requested, one
# row per suite, and a closing note saying in words what the record is not.
# That record's honesty field is `measured`; this one's is `suites[].state` —
# `not-attempted` is a state a reader can see, never an omitted row.
#
# It is written under test-results/, which .gitignore excludes, so the lane
# still writes no tracked file.

# One line of what the lane saw, quoted into the record verbatim. Every finding
# goes through device_fail or device_pass so that a reader of the record and a
# reader of the terminal are looking at the same sentences.
device_observe() { printf '%s\n' "$*" >> "$TMP/device-observations"; }

device_fail() { hard "$*"; device_observe "$*"; }
device_pass() { pass "$*"; device_observe "$*"; }

# device_suite_state <suite> <state> — the furthest state a suite reached.
# Appended rather than replaced; the record reads the last row per suite, so a
# suite that was declared, built and then failed reports "failed".
device_suite_state() { printf '%s\t%s\n' "$1" "$2" >> "$TMP/device-suites"; }

# Whether the repository declares a suite at all. Static, so it answers on a
# host with no checkout and no device: a suite named here and declared in no
# build file is the "no instrumented suite exists" outcome, and the record has
# to be able to say that rather than blame the absent device.
# A commented-out target is not a declaration. `grep -q` alone would read the
# comment that survived a deleted target as the target itself, which is the one
# reading this probe exists to rule out: a suite that no build file declares any
# more would keep reporting `declared` for as long as any BUILD.gn still named
# it in prose. Counting the non-comment matches answers that, and counting
# rather than piping into `grep -q` keeps `pipefail` from turning the early
# close of a short-circuiting reader into a false "not declared".
# A suite whose declaration is a numbered upstream patch is declared by this
# repository too — the patch specification is a tracked file and the `chromium`
# lane gates it. Reading only taffy-core/ would report
# `taffy_profile_browsertests` as "no such suite exists" on every host, which
# is the one answer that is certainly wrong: the target is in the graph, and
# blaming an absent suite for what is really an absent device is exactly the
# confusion this probe exists to prevent.
device_suite_declared() {
  local hits patch_hits
  hits=$(grep -rh --include=BUILD.gn -- "(\"$1\")" "$TAFFY_ROOT/taffy-core" 2>/dev/null \
         | grep -cv '^[[:space:]]*#' || true)
  # A suite the product declares inside a numbered upstream patch is declared
  # just as firmly as one in taffy-core/: the queue is the only writer of that
  # upstream BUILD.gn, and the checkout it lands in is the one this lane would
  # build. Match the exported diff's own added target line rather than a prose
  # mention, so a specification that merely names a suite cannot stand in for
  # one.
  patch_hits=$(grep -rh --include='*.patch' -- "^+.*(\"$1\")" \
         "$TAFFY_ROOT/chromium/patches" 2>/dev/null | grep -c '^' || true)
  [ "${hits:-0}" -gt 0 ] || [ "${patch_hits:-0}" -gt 0 ]
}

# The body of a JSON string. Shell values reaching this record are single-line
# — serials, ABIs, profile names, suite names and the lane's own sentences — so
# a quote and a backslash are the only characters JSON cannot take as they are.
device_json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r'
}

device_write_evidence() { # <verdict>
  local verdict=$1 path dir stamp name state first line selected
  stamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  path=${DEVICE_EVIDENCE:-$TAFFY_ROOT/test-results/device-$(date -u '+%Y%m%dT%H%M%SZ').json}
  dir=$(dirname "$path")
  if ! mkdir -p "$dir" 2>/dev/null; then
    soft "device: cannot create $dir, so no evidence record was written"
    return 0
  fi
  if [ -n "$DEVICE_TARGET" ]; then selected=true; else selected=false; fi
  {
    printf '{\n'
    printf '  "evidence_version": 1,\n'
    printf '  "generated_at": "%s",\n' "$stamp"
    printf '  "host": "%s",\n' "$(device_json_string "$(taffy_os)/$(taffy_arch)")"
    printf '  "lane": "device",\n'
    printf '  "command": "%s",\n' "$(device_json_string "$DEVICE_COMMAND")"
    printf '  "target": {\n'
    printf '    "selected": %s,\n' "$selected"
    printf '    "adb": "%s",\n' "$(device_json_string "$DEVICE_ADB")"
    printf '    "serial": "%s",\n' "$(device_json_string "$DEVICE_TARGET")"
    printf '    "abi": "%s",\n' "$(device_json_string "$DEVICE_ABI")"
    printf '    "profile": "%s"\n' "$(device_json_string "$DEVICE_PROFILE_USED")"
    printf '  },\n'
    printf '  "suites": [\n'
    first=1
    for name in $DEVICE_SUITE_TARGETS; do
      state=$(awk -F'\t' -v want="$name" \
        '$1 == want { last = $2 } END { print (last == "" ? "not-attempted" : last) }' \
        "$TMP/device-suites")
      if [ "$first" = 1 ]; then first=0; else printf ',\n'; fi
      printf '    { "name": "%s", "state": "%s" }' "$name" "$state"
    done
    printf '\n  ],\n'
    printf '  "observations": [\n'
    first=1
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      if [ "$first" = 1 ]; then first=0; else printf ',\n'; fi
      printf '    "%s"' "$(device_json_string "$line")"
    done < "$TMP/device-observations"
    if [ "$first" != 1 ]; then printf '\n'; fi
    printf '  ],\n'
    printf '  "verdict": "%s",\n' "$verdict"
    printf '  "note": "%s"\n' "$(device_json_string "$DEVICE_EVIDENCE_NOTE")"
    printf '}\n'
  } > "$path"
  note "device evidence record: ${path#"$TAFFY_ROOT"/}"
  return 0
}

DEVICE_EVIDENCE_NOTE='This record says what the device lane observed on this host and nothing more. A suite carries the furthest state it actually reached, so not-attempted and not-declared are visible rather than absent, and no state here is a claim that a suite ran. A suite state of not-declared means no instrumented suite exists for that name in this tree. The verdict is the lane verdict, which this record does not decide.'

check_device() {
  local before
  : > "$TMP/device-observations"
  : > "$TMP/device-suites"
  DEVICE_ADB=''
  DEVICE_TARGET=''
  DEVICE_ABI=''
  DEVICE_PROFILE_USED=''
  DEVICE_COMMAND='./tools/check device'
  [ -n "$DEVICE_PROFILE" ] && DEVICE_COMMAND="$DEVICE_COMMAND --profile $DEVICE_PROFILE"
  [ -n "$DEVICE_SERIAL" ] && DEVICE_COMMAND="$DEVICE_COMMAND --device $DEVICE_SERIAL"
  # Including --evidence is what makes the record's own `command` field a
  # command that reproduces this record, rather than one that writes a
  # different file.
  [ -n "$DEVICE_EVIDENCE" ] && DEVICE_COMMAND="$DEVICE_COMMAND --evidence $DEVICE_EVIDENCE"
  before=$N_FAIL
  device_lane
  if [ "$N_FAIL" -gt "$before" ]; then
    device_write_evidence failed
  else
    device_write_evidence passed
  fi
  return 0
}

device_lane() {
  step "device: the suites this lane declares"
  local adb_path sdk serial devices count abi profile expected_abi suite undeclared

  # Before anything is selected or built, because it is the one question this
  # lane can answer on any host: does the tree declare the suite at all. A "no"
  # here is the honest reading of a failing lane, and without it a missing
  # suite is indistinguishable from a missing device.
  undeclared=0
  for suite in $DEVICE_SUITE_TARGETS; do
    if device_suite_declared "$suite"; then
      device_suite_state "$suite" declared
    else
      device_suite_state "$suite" not-declared
      undeclared=$((undeclared + 1))
      device_observe "no instrumented suite exists: $suite is declared in no BUILD.gn under taffy-core/ and in no patch under chromium/patches/"
    fi
  done
  if [ "$undeclared" -eq 0 ]; then
    device_pass "declared: $DEVICE_SUITE_TARGETS"
  else
    note "$undeclared of the lane's suites are declared nowhere; the build below will say so too"
  fi

  step "device: select one attached Android target"
  adb_path=$(command -v adb 2>/dev/null || true)
  if [ -z "$adb_path" ]; then
    sdk=$(taffy_android_sdk_root 2>/dev/null || true)
    if [ -n "$sdk" ] && [ -x "$sdk/platform-tools/adb" ]; then
      adb_path="$sdk/platform-tools/adb"
      PATH="$sdk/platform-tools:$PATH"
      export PATH
    fi
  fi
  if [ -z "$adb_path" ]; then
    device_fail "device: adb is unavailable; install the pinned Android SDK with ./tools/bootstrap --profile android"
    return 0
  fi
  DEVICE_ADB=$adb_path

  serial=${DEVICE_SERIAL:-${ANDROID_SERIAL:-}}
  devices=$(
    "$adb_path" devices 2>/dev/null \
      | awk 'NR > 1 && $2 == "device" { print $1 }'
  )
  if [ -n "$serial" ]; then
    if ! printf '%s\n' "$devices" | grep -Fqx "$serial"; then
      device_fail "device: $serial is not online and authorized according to adb devices"
      return 0
    fi
  else
    count=$(printf '%s\n' "$devices" | awk 'NF { n += 1 } END { print n + 0 }')
    case "$count" in
      0)
        device_fail "device: no online, authorized adb device is attached"
        return 0
        ;;
      1) serial=$devices ;;
      *)
        device_fail "device: $count devices are attached; select one with --device <serial>"
        printf '%s\n' "$devices" | while IFS= read -r candidate; do
          [ -n "$candidate" ] && note "  $candidate"
        done
        return 0
        ;;
    esac
  fi

  abi=$("$adb_path" -s "$serial" shell getprop ro.product.cpu.abi 2>/dev/null \
        | tr -d '\r[:space:]')
  case "$abi" in
    arm64-v8a) expected_abi=dev-arm64 ;;
    x86_64) expected_abi=dev-x64 ;;
    *)
      DEVICE_TARGET=$serial
      DEVICE_ABI=$abi
      device_fail "device: unsupported ABI '$abi'; committed device profiles cover arm64-v8a and x86_64"
      return 0
      ;;
  esac
  profile=${DEVICE_PROFILE:-$expected_abi}
  case "$profile" in
    dev-arm64|dev-x64) : ;;
    *)
      DEVICE_TARGET=$serial
      DEVICE_ABI=$abi
      device_fail "device: --profile must be dev-arm64 or dev-x64 (got '$profile')"
      return 0
      ;;
  esac
  DEVICE_TARGET=$serial
  DEVICE_ABI=$abi
  if [ "$profile" != "$expected_abi" ]; then
    device_fail "device: $serial reports $abi, which requires $expected_abi rather than $profile"
    return 0
  fi
  DEVICE_PROFILE_USED=$profile
  device_pass "$serial ($abi), profile $profile"

  step "device: build every declared TaffyGo integration suite"
  # One list, word-split into separate arguments, so that the suites the
  # evidence record reports are exactly the suites the build is asked for.
  # shellcheck disable=SC2086
  if "$TAFFY_ROOT/tools/chromium/build" --profile "$profile" $DEVICE_SUITE_TARGETS; then
    device_pass "device suite build"
    for suite in $DEVICE_SUITE_TARGETS; do
      device_suite_state "$suite" built
    done
  else
    device_fail "device suite build"
    return 0
  fi

  # Run separately. The wrapper rejects an exit-zero suite that reports zero
  # tests, and separate invocations ensure one failure does not prevent the
  # remaining suites from producing evidence.
  for suite in $DEVICE_SUITE_TARGETS; do
    step "device: $suite"
    if "$TAFFY_ROOT/tools/chromium/test" --profile "$profile" \
         --device "$serial" "$suite"; then
      device_pass "$suite"
      device_suite_state "$suite" passed
    else
      device_fail "$suite"
      device_suite_state "$suite" failed
    fi
  done
}

summary() {
  info ""
  if [ "$N_FAIL" -gt 0 ]; then
    printf '%s%d failing%s, %d warning(s), %d skipped\n' "$C_RED$C_BOLD" "$N_FAIL" "$C_RESET" "$N_WARN" "$N_SKIP" >&2
    return 1
  fi
  printf '%sall checks passed%s — %d warning(s), %d skipped\n' "$C_GREEN" "$C_RESET" "$N_WARN" "$N_SKIP" >&2
}

case "$LANE" in
  docs) check_docs ;;
  fast) check_fast ;;
  device) check_device ;;
  all) check_docs; check_fast ;;
  '') usage; exit 0 ;;
  *) usage >&2; die "unknown lane: $LANE" ;;
esac

summary

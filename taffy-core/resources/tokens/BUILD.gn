# The generated Kotlin projection is compiled by the Android design-system
# target; the C++ header and CSS projection are platform-neutral inputs for
# future Views and WebUI surfaces. This group makes the source and all three
# checked-in projections visible to the product graph without claiming a
# desktop product target.
source_set("tokens") {
  sources = [
    "generated/cpp/taffy_color_tokens.h",
    "taffy_color_tokens.cc",
  ]

  metadata = {
    taffy_design_token_source = [ "//taffy/resources/tokens/tokens.json" ]
    taffy_design_token_projections = [
      "//taffy/resources/tokens/generated/cpp/taffy_color_tokens.h",
      "//taffy/resources/tokens/generated/css/taffy-color-tokens.css",
      "//taffy/resources/tokens/generated/kotlin/com/taffygo/browser/ui/core/designsystem/internal/GeneratedTaffyPalette.kt",
    ]
  }
}

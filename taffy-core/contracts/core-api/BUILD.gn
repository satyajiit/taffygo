import("//mojo/public/tools/bindings/mojom.gni")

mojom("core_api_types") {
  sources = [ "generated/mojom/core_api.mojom" ]
  generate_java = true
  public_deps = []
}

# The generated closed-enumeration decoders; see the same target under
# //taffy/contracts/core-service for why C++ needs one and Rust does not.
source_set("core_api_enums") {
  sources = [ "generated/cpp/core_api_enums.h" ]
  public_deps = [ ":core_api_types" ]
}

# Stable directory label used by platform facades. The generated Mojo target
# name may evolve without leaking generator mechanics into consumers.
group("core-api") {
  public_deps = [
    ":core_api_enums",
    ":core_api_types",
  ]
}

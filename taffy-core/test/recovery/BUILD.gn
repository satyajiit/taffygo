# The production Chrome-profile crash boundary. This suite is intentionally
# separate from //taffy/test's portable Content Shell harness: only Chrome owns
# a real Profile and installs the shipping Taffy utility-service registry.
# Patch 0030 mounts this test-only source set into Chrome's host and Android
# browser-test runners. No product target depends on it.
if (is_android) {
  import("//third_party/jni_zero/jni_zero.gni")

  generate_jni("task_pdf_handoff_jni_headers") {
    testonly = true
    sources = [ "java/src/org/chromium/taffy/shell/TaffyTaskPdfTestBridge.java" ]
  }

}


# The shared test support and the three Taffy suites: parity and recovery
# (work package WP-M1-06), page-intelligence correctness, and adversarial
# validation (WP-M2-08).
#
# This directory sits below both process halves, which is the whole reason it
# exists. //taffy/browser may not include //taffy/renderer and the reverse is a
# build error, so anything both halves need — the corpus reader above all —
# had nowhere to live. It lives here, and both may depend on it without either
# depending on the other.
#
# The suites are separate targets rather than one because they run in different
# places and answer to different owners. The parity suite is milestone-M1 exit
# evidence and needs no renderer endpoint. The correctness suite is milestone-M2
# and cannot run without one. The adversarial suite binds its own scripted
# endpoint and needs neither.

# ---------------------------------------------------------------------------
# The corpus reader
# ---------------------------------------------------------------------------

# The single reader of test-fixtures/web/manifest.json, for both process halves.
#
# It replaces two readers written independently because no directory existed
# that both halves could depend on: //taffy/browser/test answered the
# browser's questions and //taffy/renderer/test answered the
# renderer's. Retiring those two is a one-line edit in each of their BUILD.gn
# files plus deleting the files, and it belongs to their owners; README.md
# carries it as item 1 of the verification list so it cannot be forgotten.
source_set("corpus") {
  testonly = true

  sources = [
    "corpus/corpus_canary.cc",
    "corpus/corpus_canary.h",
    "corpus/corpus_expected_field.cc",
    "corpus/corpus_expected_field.h",
    "corpus/corpus_fixture.cc",
    "corpus/corpus_fixture.h",
    "corpus/corpus_manifest.cc",
    "corpus/corpus_manifest.h",
    "corpus/corpus_mount.cc",
    "corpus/corpus_mount.h",
    "corpus/corpus_origin.cc",
    "corpus/corpus_origin.h",
  ]

  deps = [ "//base" ]

  # The corpus must be present at //taffy/test/data/web when
  # anything here runs. Until the fork tooling mounts it, every read fails at
  # CorpusMount with the expected path in the message, which is the intended
  # behaviour: see corpus/corpus_mount.h.
  data = [ "//taffy/test/data/web/" ]
}


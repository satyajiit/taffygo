# All three suites, by reference.
#
# HOW THESE REACH A TEST BINARY — the SP-01 question. The answer is a dep from
# `test("taffy_browsertests")` in //taffy/BUILD.gn, which is the
# cheap option: no standalone test() target here, and no edit to a
# Chromium-owned build file such as //chrome/test:browser_tests, which would
# have cost a patch. The same item in //taffy/browser/BUILD.gn has
# the same answer, and there it is already wired.
#
# THAT DEP IS LIVE as of 2026-08-19, and what it cost is the reason to read the
# header of every target below before trusting it. Until that day GN never
# loaded this file — a build file is loaded only when an already-loaded file
# names a label in it — so `gn ls "//taffy/test:*"` returned nothing
# and none of the twenty-two files below was compiled. Nothing failed; the suite
# simply ran the browser/ tests and reported them all passing. Three build-file
# defects and 79 compile errors had accumulated behind that silence, including
# one assertion on a struct field that does not exist. They are fixed and the
# suites run; the lesson is that this file was syntax-checked by GN exactly
# once before then, and no gate could have said so. `./tools/chromium/
# orphan-targets` is the check that now would.
# The tool seam with its processes actually running. Everything below the seam
# is provable without one; process isolation, the concurrency bound, and a
# descriptor surviving the crossing are not.
source_set("tool_browser_tests") {
  testonly = true

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "tool/media_tool_worker_browsertest.cc" ]

  if (taffy_python_runtime_in_current_toolchain) {
    sources += [
      "tool/python_tool_worker_browsertest.cc",
      "tool/python_tool_worker_sp07_browsertest.cc",
      "tool/python_tool_worker_sp07_test_support.cc",
      "tool/python_tool_worker_sp07_test_support.h",
    ]
  }

  deps = [
    "//base",
    "//base/test:test_support",
    "//content/public/browser",
    "//content/shell:content_shell_lib",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//taffy/browser:browser_shared",
    "//taffy/contracts/tool-runtime:tool_runtime_mojom",
    "//taffy/services/tool-runtime/media:test_support",
    "//taffy/services/tool-runtime/supervisor",
    "//testing/gtest",
    "//third_party/zlib/google:zip",
  ]
}

# The Task Benchmark's observation adapter.
#
# It is a suite of its own rather than a case inside another because it answers
# to a different reader: `tools/benchmark.d/launcher.py` selects exactly one
# case per scenario by name and recovers a record from each, so what these
# tests print is a wire format, and its shape is owned by that launcher and by
# `tools/benchmark.d/score.py`. A benchmark adapter mixed into a correctness
# suite would be run by the correctness suite's own selections, which is how a
# record comes to be emitted for a scenario nobody selected.
source_set("benchmark_browser_tests") {
  testonly = true

  # Upstream's browser-test define, on the source set rather than on the
  # binary, for the same reason as the sets above: browser_test.h refuses to
  # compile without it.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "benchmark/task_benchmark_observation_browsertest.cc" ]

  # The same four as the browser-test sets above, for the same reason: the
  # fixture derives from content::ContentBrowserTest, whose implementation the
  # shell library carries. Naming them here rather than inheriting them from a
  # sibling set keeps this one buildable on its own.
  deps = [
    ":benchmark_page_evidence",
    ":benchmark_support",
    ":support",
    "//base",
    "//content/public/browser",
    "//content/shell:content_shell_lib",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//crypto",
    "//testing/gtest",
    "//url",
  ]
}

group("browser_tests") {
  testonly = true

  deps = [
    ":adversarial_browser_tests",
    ":benchmark_browser_tests",
    ":correctness_browser_tests",
    ":parity_browser_tests",
    ":tool_browser_tests",
  ]
}

group("fuzzers") {
  testonly = true

  deps = [ "//taffy/test/fuzz:fuzzers" ]
}

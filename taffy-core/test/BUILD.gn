# ---------------------------------------------------------------------------
# The binary's own process setup
# ---------------------------------------------------------------------------

# The renderer client and the main delegate that install TaffyGo's render frame
# observer in the processes `taffy_browsertests` starts.
#
# WHY IT IS A TARGET AT ALL. Until 2026-08-19 that binary was a plain
# content_shell browser-test binary, so content_shell's own renderer client ran
# in its renderer processes and no Taffy endpoint existed. The browser half
# answers UNSUPPORTED when nothing answers negotiation and keeps answering it,
# so every test in ":correctness_browser_tests" — and every adversarial test
# whose subject is what the real endpoint produces — failed at
# RendererEndpointRequirement::Require with the instruction that named this as
# the missing piece.
#
# IT IS FINISHED, as of 2026-09-07. This target was always the half that
# worked. What kept negotiation reporting UNSUPPORTED after it landed was a
# stale copy of the protocol version in //taffy/renderer, two minor steps
# behind the contract, which the browser half refuses by design — so the tests
# above failed for a reason that had nothing to do with the renderer client.
# See the header of taffy_content_renderer_client.h for what the search cost
# and why its stated suspects were wrong.
#
# Separate from ":support" on purpose. ":support" is what a test links; this is
# what the BINARY links, once, and nothing in a test may reach it. Keeping them
# apart is also what keeps the process-half rule readable: this is the only
# target under //taffy/test that names //taffy/renderer.
source_set("browser_test_launcher") {
  testonly = true

  sources = [
    "taffy_browser_test_main_delegate.cc",
    "taffy_browser_test_main_delegate.h",
    "taffy_content_renderer_client.cc",
    "taffy_content_renderer_client.h",
    "taffy_content_utility_client.cc",
    "taffy_content_utility_client.h",
  ]

  if (is_android) {
    # JNI_OnLoad. On Android this is the only place the ContentMainDelegate is
    # chosen — ContentTestLauncherDelegate::CreateContentMainDelegate is
    # compiled out under `#if !BUILDFLAG(IS_ANDROID)` — which is why the file
    # is a copy of upstream's rather than a reference to it. Its header says so
    # and says what to diff it against on a rebase.
    sources += [ "android/taffy_browsertests_jni_onload.cc" ]
  }

  deps = [
    "//base",
    "//content/public/renderer",
    "//content/public/utility",
    "//content/shell:content_shell_lib",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//taffy/components/filtering/renderer",
    "//taffy/renderer",
    "//taffy/utility:registry",
  ]

  if (is_android) {
    deps += [
      "//content/public/app",
      "//content/test:android_test_message_pump_support",
      "//testing/android/native_test:native_test_support",
    ]
  }
}

# ---------------------------------------------------------------------------
# The suites
# ---------------------------------------------------------------------------

# WP-M1-06. Every milestone-M1 Required parity row that is only observable in a
# real browser: navigation and redirect, error and interstitial pages, tab
# restore, eviction and crash recovery with no blind replay, rotation and
# configuration change, foreground and background transitions, the download
# lifecycle, and the guarantee that all of it works with the assistant
# unavailable.
#
# TEST-INDEX.md maps every test in here to the requirement it proves.
source_set("parity_browser_tests") {
  testonly = true

  # Upstream's browser-test define, on the source set rather than on the
  # binary: content/public/test/browser_test.h refuses to compile without it
  # ("Can't reliably terminate hanging event tests without OOP test runner"),
  # and a `defines` on the test() target reaches only that target's own
  # sources. //taffy/browser:browser_tests carries it for the same
  # reason, and these sets were missing it because nothing ever compiled them.
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "parity/ai_unavailable_parity_browsertest.cc",
    "parity/download_lifecycle_browsertest.cc",
    "parity/error_and_interstitial_browsertest.cc",
    "parity/lifecycle_and_rotation_browsertest.cc",
    "parity/navigation_and_redirect_browsertest.cc",
    "parity/renderer_crash_recovery_browsertest.cc",
    "parity/tab_restore_and_recovery_browsertest.cc",
    "parity/web_platform_and_session_browsertest.cc",
  ]

  deps = [
    ":support",
    "//base",

    # The download parity rows are asserted against Chromium's own download
    # system rather than a fake, because the row is about that system's
    # behaviour being preserved.
    "//components/download/public/common:public",
    "//content/public/browser",
    "//content/shell:content_shell_lib",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",

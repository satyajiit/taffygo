# Self-instrumenting: this APK contains only deterministic Compose surfaces and
# their test Activity. Browser-integrated behavior belongs to
# `taffy_browsertests`; this suite must not inherit the product's authority.
instrumentation_test_apk("taffy_public_test_apk") {
  testonly = true
  apk_name = taffy_test_apk_name
  target_sdk_version = "37"
  # The incremental bootstrap registers android.app.Instrumentation and then
  # swaps in AndroidX. That indirection does not forward AndroidX's list-only
  # status stream on the Xiaomi device, so Chromium sees an empty test list.
  # This is a small, self-contained test APK; install the real manifest and
  # runner so discovery and execution observe the same component.
  never_incremental = true
  # These are ordinary AndroidX/Compose JUnit4 tests, not Chromium
  # BaseJUnit4ClassRunner tests. The default launcher injects Chromium's list
  # listener, which must execute every non-Base runner test merely to discover
  # its name; the aggregate suite then times out in its list phase. AndroidX's
  # runner has a true list-only mode and owns this self-instrumenting APK.
  use_default_launcher = false
  android_manifest = "$target_gen_dir/AndroidManifest.xml"
  android_manifest_dep = ":ui_instrumentation_manifest"
  deps = [
    ":core_ui_instrumentation_tests_java",
    ":feature_assistant_instrumentation_tests_java",
    ":feature_browsing_instrumentation_tests_java",
    ":feature_downloads_instrumentation_tests_java",
    ":feature_onboarding_instrumentation_tests_java",
    ":feature_providers_instrumentation_tests_java",
    ":feature_settings_instrumentation_tests_java",
    ":feature_workspaces_instrumentation_tests_java",
    ":ui_instrumentation_resources",
  ]
}

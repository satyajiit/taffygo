# The device half of the retained Compose UI. These are the same canonical
# `src/androidTest` sources Gradle runs in the fast Android loop; GN packages
# them here so the shipping graph, pinned AndroidX closure, manifest merge and
# Chromium runner see them too.

import("//build/config/android/rules.gni")
import("//taffy/app/android/kotlin_sources.gni")
import("//taffy/app/android/taffy_android_deps.gni")
import("//taffy/app/android/taffy_dagger_library.gni")
import("//taffy/resources/branding/taffy_branding.gni")

_compose = taffy_androidx_compose_deps
_coroutines = taffy_kotlin_coroutines_deps
_inject = [ "//third_party/android_deps:javax_inject_javax_inject_java" ]
_kotlin = taffy_kotlin_deps
_lifecycle = taffy_androidx_lifecycle_deps

_feature_platform_deps = [ "//third_party/androidx:androidx_lifecycle_lifecycle_viewmodel_compose_java" ] + _compose + _coroutines + _inject + _kotlin + _lifecycle

_test_deps = [
  "//third_party/androidx:androidx_compose_ui_ui_test_android_java",
  "//third_party/androidx:androidx_compose_ui_ui_test_junit4_java",
  "//third_party/androidx:androidx_compose_ui_ui_test_manifest_java",
  "//third_party/androidx:androidx_test_core_java",
  "//third_party/androidx:androidx_test_ext_junit_java",
  "//third_party/androidx:androidx_test_monitor_java",
  "//third_party/androidx:androidx_test_runner_java",
  "//third_party/junit",
]

# Gradle compiles each module's main, debug and androidTest source sets as one
# Kotlin friend unit. Mirror that boundary here: a single aggregate test jar
# makes every legitimate `internal` test access fail, while depending on the
# production jar cannot recover Kotlin's compile-time module visibility. Keep
# the Dagger rule visible at each target declaration as well: the repository's
# static GN graph checker follows one template expansion and must see the same
# runtime edge that configured GN sees.
taffy_dagger_library("core_ui_instrumentation_tests_java") {
  testonly = true
  sources = taffy_core_ui_sources + taffy_core_ui_android_test_fixture_sources +
            taffy_core_ui_android_test_sources
  chromium_code = false
  enable_compose = true
  resources_package = "com.taffygo.browser.ui.core.ui"
  deps = [
           "//taffy/app/android/ui:core_browser_java",
           "//taffy/app/android/ui:core_common_java",
           "//taffy/app/android/ui:core_designsystem_java",
           "//taffy/app/android/ui:core_model_java",
           "//taffy/app/android/ui:core_ui_profile_banner_assets",
           "//taffy/app/android/ui:core_ui_resources",
           "//third_party/androidx:androidx_activity_activity_compose_java",
           "//third_party/androidx:androidx_lifecycle_lifecycle_viewmodel_compose_java",
         ] + _compose + _coroutines + _inject + _kotlin + _lifecycle +
         _test_deps
}


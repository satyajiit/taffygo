  sources = taffy_feature_onboarding_sources
  chromium_code = false

  # OD-076. This waiver is `HorizontalPager`'s, not TaffyGo's, and it cannot be
  # paid off by changing our own code — which was tried on 2026-08-23 and is
  # why this comment exists. Every first-party use of
  # `androidx.compose.animation.core` was removed from this module that day:
  # the showcase prompt's two `Animatable`s became one `taffyRunOnce`, and the
  # carousel's `animateScrollToPage(animationSpec = tween(...))` became the
  # default overload. Two references remain in the compiled bytecode and both
  # come from `PagerDefaults.flingBehavior`, whose descriptor names
  # `DecayAnimationSpec` and `AnimationSpec`:
  #
  #   PagerDefaults.flingBehavior:(...Landroidx/compose/animation/core/
  #     DecayAnimationSpec;Landroidx/compose/animation/core/AnimationSpec;...)
  #
  # `androidx.compose.animation.core`'s target and its alias both restrict
  # visibility to `//third_party/androidx:*` at the pinned milestone, so there
  # is no consumable form to add to `deps`. The only ways out are to stop using
  # the pager or for upstream to widen that list; neither is a downstream edit,
  # which makes this the one instance of OD-076 that is genuinely not ours.
  enable_bytecode_checks = false
  enable_compose = true
  resources_package = "com.taffygo.browser.ui.feature.onboarding"
  deps = [
           ":core_analytics_java",
           ":core_api_java",
           ":core_designsystem_java",
           ":core_model_java",
           ":core_preferences_java",
           ":core_ui_java",
           ":feature_onboarding_resources",
         ] + _feature_platform_deps
}


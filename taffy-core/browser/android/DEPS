# The JNI edge of //taffy/browser: native entry points and nothing else.
#
# These are the only //taffy sources anywhere that may name a //chrome Android
# object. They are built by //taffy/browser/android:jni_bridges, which nothing
# but libchrome links, because jni_zero resolves the Java peer of every native
# it registers at process start and two of those peers live in
# //chrome/android:chrome_java — a test APK that linked them aborted before any
# test body ran.
#
# The account plane, the Core API facade and the Core API command factory used
# to live here too, and none of them named an Android type; decision 0042 moved
# them to //taffy/browser/account and //taffy/browser/core_api, where they
# build on every platform. What is left is the edge itself.
#
# The parent DEPS file allows three profile-ownership headers for the whole of
# //taffy/browser. `-chrome` takes that back for this directory and the
# specific rules below hand it out again, one file at a time, so that a new
# source here cannot quietly acquire an embedder type and put the test binaries
# back where they were: unlinkable, and aborting at startup on a Java class the
# APK does not carry.
include_rules = [
  "-chrome",

  "+base",
  "+content/public/browser",
  "+mojo/public/cpp/bindings",
  "+taffy/browser",
  "+taffy/contracts/core-api/generated/mojom",
  "+taffy/contracts/core-service/generated/mojom",
  "+taffy/resources/branding",
]


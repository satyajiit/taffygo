  "backup_workflow_bridge\\.cc": [
    "+chrome/browser/profiles/profile.h",
  ],
  "backup_workflow_bridge_internal\\.cc": [
    "+chrome/browser/browser_process.h",
    "+chrome/browser/profiles/nuke_profile_directory_utils.h",
    "+chrome/browser/profiles/profile.h",
    "+chrome/browser/profiles/profile_attributes_entry.h",
    "+chrome/browser/profiles/profile_attributes_storage.h",
    "+chrome/browser/profiles/profile_manager.h",
  ],
  "backup_workflow_restore_android\\.cc": [
    "+chrome/browser/profiles/profile.h",
  ],
  # Profile lifecycle stays behind one product-owned JNI seam. Java receives
  # opaque identifiers and display names, never profile directory paths.
  "browser_profiles_bridge\\.cc": [
    "+chrome/browser/browser_process.h",
    "+chrome/browser/profiles/delete_profile_helper.h",
    "+chrome/browser/profiles/nuke_profile_directory_utils.h",
    "+chrome/browser/profiles/profile.h",
    "+chrome/browser/profiles/profile_attributes_entry.h",
    "+chrome/browser/profiles/profile_attributes_storage.h",
    "+chrome/browser/profiles/profile_manager.h",
    "+chrome/browser/profiles/profile_metrics.h",
  ],
  # Restart discovery reads the sole exact reservation from durable Local
  # State and Chromium's own profile metadata. It never activates a profile;
  # the only physical act it may reach is deleting a candidate it has already
  # matched, through the same upstream helper the resolution path uses.
  "browser_profiles_restore_discovery_android\\.cc": [
    "+chrome/browser/profiles/profile.h",
    "+chrome/browser/profiles/profile_attributes_entry.h",
    "+chrome/browser/profiles/profile_attributes_storage.h",
    "+chrome/browser/profiles/profile_manager.h",
  ],
  "browser_profiles_restore_discovery_android_helpers\\.cc": [
    "+chrome/browser/profiles/nuke_profile_directory_utils.h",
    "+chrome/browser/profiles/profile.h",
    "+chrome/browser/profiles/profile_attributes_entry.h",
    "+chrome/browser/profiles/profile_attributes_storage.h",
    "+chrome/browser/profiles/profile_manager.h",
  ],
  "browser_profiles_restore_discovery_android_observation\\.cc": [
    "+chrome/browser/profiles/nuke_profile_directory_utils.h",
    "+chrome/browser/profiles/profile_manager.h",

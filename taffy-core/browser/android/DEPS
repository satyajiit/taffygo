  # Screen SCR-110's page is the one surface in the product that must never
  # write history: it carries a vendor's authorization address, which carries
  # the flow's `state`, its PKCE challenge and often the account being signed
  # in as. The tab header resolves the Java peer to its WebContents; the
  # history header is named only for `HistoryTabHelper::UserDataKey()`, so that
  # an upstream rename of that helper is a compile error here rather than a
  # surface that silently starts recording again.
  "errand_page_bridge\\.cc": [
    "+chrome/browser/android/tab_android.h",
    "+chrome/browser/history/history_tab_helper.h",
  ],
  # The JNI entry points. Each one resolves the Java peer of a Profile before
  # it may reach the profile-keyed service, which is what the header is for.
  # The filtering bridge also resolves a Tab to its WebContents, for the
  # per-tab blocked count — the same two-header embedder seam the selection
  # bridge argues for below.
  "filtering_bridge\\.cc": [

  # The download surface resolves one exact regular Profile to Chromium's
  # profile-keyed offline-content aggregator. It returns only the existing
  # Android provider bridge; download mechanics remain upstream-owned.
  "download_provider_bridge\.cc": [
    "+chrome/browser/offline_items_collection/offline_content_aggregator_factory.h",

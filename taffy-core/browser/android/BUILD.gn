# One source-authoritative Java closure paired with every JNI native half that
# //taffy/browser adds to libchrome. Chromium's registration metadata consumes
# this group; no source is copied into an upstream target.
java_group("jni_bridge_java") {
  public_deps = [
    ":attribution_notice_java",
    ":backup_workflow_java",
    ":browser_profiles_java",
    ":core_api_java",
    ":download_provider_java",
    ":errand_page_java",
    ":field_value_java",
    ":filtering_java",
    ":page_inspector_java",
    ":pdf_intelligence_java",
    ":profile_platform_java",
    ":regular_profile_loader_java",
    ":task_source_selection_java",
    "//components/embedder_support/android:view_java",
  ]
}

# The native half of ":jni_bridge_java", and the only //taffy code anywhere that
# is typed against a //chrome Android object.
#
# Two facts make this a target of its own rather than more sources in
# //taffy/browser:browser_shared, and both were paid for before the split
# existed:
#
#   * Link. profile_platform_bridge.cc calls Profile::FromJavaObject and
#     task_source_selection_bridge.cc's @JniType("TabAndroid*") glue calls
#     TabAndroid::GetNativeTab. Those are defined in
#     //chrome/browser/profiles:misc and //chrome/browser/android:tabs_public,
#     neither of which a content_shell binary links, so taffy_browsertests could
#     not be linked at all while these sources were in the browser library.
#   * Registration. jni_zero resolves the Java peer of every native it
#     registers when the process starts. These bridges resolve
#     org.chromium.chrome.browser.profiles.Profile and TabAndroid, which live in
#     //chrome/android:chrome_java, so a test APK that linked them aborted at
#     startup with ClassNotFoundException before any test body ran.
#
# libchrome is the only binary that carries both halves, and //taffy/browser's
# group is the only edge that reaches this target. Nothing test-only may depend
# on it: a test that needs a Profile uses //chrome/test's harnesses, and a test
# that needs a page uses content_shell.
source_set("regular_profile_token") {
  sources = [
    "regular_profile_token.cc",
    "regular_profile_token.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/android:profile_token",
    "//crypto",
  ]
}


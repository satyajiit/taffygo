    "backup_workflow_restore_projection.cc",
    "backup_workflow_restore_projection.h",
    "browser_profiles_restore_lifecycle.cc",
    "browser_profiles_restore_lifecycle_binding.cc",
    "browser_profiles_restore_lifecycle_creation.cc",
    "browser_profiles_restore_lifecycle_precommit_cancel.cc",
    "browser_profiles_restore_precommit_cleanup_handle.cc",
  ]
  public_deps = [
    "//base",
    "//taffy/browser:backup_restore_dormant_target_owner",
  ]
  deps = [
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile_util",
    "//chrome/common",
    "//components/prefs",
    "//content/public/browser",
    "//taffy/browser:backup_restore_preference_readback",

    ":field_value_jni_headers",
    ":filtering_jni_headers",
    ":page_inspector_jni_headers",
    ":pdf_intelligence_jni_headers",
    ":profile_platform_jni_headers",
    ":regular_profile_loader_jni_headers",
    ":regular_profile_token",
    ":restore_profile_lifecycle",
    ":task_source_selection_jni_headers",
    "//base",

    # The Java peer of a tab, resolved to its native WebContents. This is the
    # dependency that may not reach a content_shell binary.
    "//chrome/browser/android:tabs_public",

    # Headers only: `HistoryTabHelper`'s user-data key, so errand_page_bridge.cc
    # can take Chromium's history recorder off one tab. The definition of that
    # key is in //chrome/browser/history:impl, which //chrome/browser already
    # links — depending on it from here would be the cycle this split exists to
    # avoid.
    "//chrome/browser/history",
    "//chrome/browser/offline_items_collection",
    "//chrome/browser/profiles",
    "//chrome/browser/renderer_host",

    # TaffyPageHostView owns ContentViewRenderView on the Java side. Keep its
    # native half in libchrome through this edge; APK Java dependencies cannot
    # carry native code into the library.
    "//components/embedder_support/android:view",
    "//components/offline_items_collection/core",
    "//content/public/browser",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//taffy/browser:browser_shared",
    "//taffy/browser:field_value_surface_mojom",
    "//taffy/browser:profile_platform_mojom",
    "//taffy/common/public",
    "//taffy/components/filtering/browser",
    "//taffy/components/storage/browser:storage",
    "//taffy/contracts/core-api",
    "//taffy/contracts/core-service",
    "//url",
  ]

# Browser-owned physical restore boundaries, separate from the portable Core
# protocol and from the Android UI/profile surface that calls them.
template("taffy_backup_restore_preference_readback") {
  not_needed(invoker, "*")
  source_set(target_name) {
    sources = [
      "backup_restore_preference_readback.cc",
      "backup_restore_preference_readback.h",
    ]
    public_deps = [ "//base" ]
  }
}

template("taffy_backup_restore_dormant_target_owner") {
  not_needed(invoker, "*")
  assert(is_android)
  source_set(target_name) {
    sources = [
      "android/browser_profiles_restore_discovery.h",
      "android/browser_profiles_restore_discovery_android.cc",
      "android/browser_profiles_restore_discovery_android_helpers.cc",
      "android/browser_profiles_restore_discovery_android_internal.h",
      "android/browser_profiles_restore_discovery_android_lifecycle.cc",
      "android/browser_profiles_restore_discovery_android_observation.cc",
      "android/browser_profiles_restore_discovery_android_retirement.cc",
      "android/browser_profiles_restore_lifecycle.h",
      "android/browser_profiles_restore_lifecycle_dormant_target.cc",
      "android/browser_profiles_restore_lifecycle_internal.h",
      "android/browser_profiles_restore_lifecycle_presentation.cc",
      "android/browser_profiles_restore_precommit_cleanup.cc",
      "android/browser_profiles_restore_precommit_cleanup.h",
      "android/browser_profiles_restore_precommit_cleanup_helpers.cc",
      "android/browser_profiles_restore_precommit_cleanup_internal.h",
      "android/browser_profiles_restore_precommit_cleanup_receipt.cc",
      "android/browser_profiles_restore_precommit_cleanup_storage.cc",
      "android/browser_profiles_restore_reconciliation_android.cc",
      "android/browser_profiles_restore_reconciliation_android_outcome.cc",

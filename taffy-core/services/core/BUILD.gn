    "service_bridge_workspace/completion.rs",
    "service_bridge_workspace/effect.rs",
    "service_bridge_workspace_ffi.rs",
  ]
  edition = "2021"

  # One entry per `#[cxx::bridge]` module. The root bridge defines no record of
  # its own any more — it names them — so every plane module below has to
  # generate its own header for the root's `include!` to find. The `include!`
  # graph between them is a DAG (operation, task effect, state, the planes that
  # wrap a response, root); the order here is alphabetical and carries nothing.
  cxx_bindings = [
    "service_bridge.rs",
    "service_bridge_account_ffi.rs",
    "service_bridge_assets_ffi.rs",
    "service_bridge_backup_ffi.rs",
    "service_bridge_bootstrap_ffi.rs",
    "service_bridge_composer_ffi.rs",
    "service_bridge_configuration_ffi.rs",

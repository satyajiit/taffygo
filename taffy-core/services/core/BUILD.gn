# The isolated profile core service. Chromium owns process lifetime, Mojo,
# sequencing, deadlines, cancellation, storage, network, tabs, and authority.
# Rust below is linked only into the utility service; //taffy/browser has no
# dependency on any Rust target in this file.

import("//build/rust/rust_static_library.gni")

# `service_bridge.rs` is the only hand-written Rust/C++ adapter. It owns one
# canonical profile-scoped core_runtime and accepts only generated typed wire
# values. No browser object, path, socket, SQL handle, or ambient authority can
# enter through this target.
rust_static_library("service_bridge") {
  crate_name = "taffy_core_service_bridge"
  crate_root = "service_bridge.rs"
  sources = [
    "service_bridge.rs",
    "service_bridge_account.rs",

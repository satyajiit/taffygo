    "service_bridge_task_command_ffi.rs",
    "service_bridge_task_effect_ffi.rs",
    "service_bridge_task_terminal_ffi.rs",
    "service_bridge_trace_ffi.rs",
    "service_bridge_workspace_ffi.rs",
  ]
  allow_unsafe = true
  deps = [
    "//taffy/components/intelligence/core/rust/core-runtime:core_runtime",
    "//third_party/rust/cxx/v1:lib",
  ]
  visibility = [ ":*" ]
}


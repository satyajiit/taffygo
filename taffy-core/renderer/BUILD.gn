# The BIP renderer endpoint and its adapters.
#
# Everything in this target runs inside the renderer sandbox and is trusted
# for nothing. The deps list is the first place that shows: there is no
# //content/public/browser, no //taffy/browser, no //net, no
# //services/network, and no way to add one without this file changing in
# review. DEPS states the same rules for the include checker.

import("//build/config/features.gni")

# Every provisional numeric bound this component enforces lives in
# observation_limits.json and is compiled from there. The generated header is
# NOT committed: committing it would create the second copy the whole design
# exists to prevent, and a second copy is a copy that drifts.
#
# The generator also refuses to run when observation_limits.json and the
# ObservationLimitsValues struct in observation_limits.h disagree, so adding a
# field to one of them is a build failure rather than a silently defaulted
# zero. `--check` runs the same comparison on any host, including one that
# cannot compile anything:
#
#   python3 tools/generate_observation_limits.py --check
#   python3 tools/generate_observation_limits.py --selftest
action("observation_limits_generated") {
  script = "tools/generate_observation_limits.py"
  inputs = [
    "observation_limits.json",
    "observation_limits.h",
  ]
  outputs = [ "$target_gen_dir/observation_limits_generated.h" ]
  args = [
    "--input",
    rebase_path("observation_limits.json", root_build_dir),
    "--header",
    rebase_path("observation_limits.h", root_build_dir),
    "--output",
    rebase_path("$target_gen_dir/observation_limits_generated.h",
                root_build_dir),
  ]
}


  public_deps = [ "//taffy/contracts/bip/mojom" ]

  configs += [ "//build/config/compiler:wexit_time_destructors" ]
}

# The invariant tests that need no renderer at all.
#
# Splitting these out is deliberate. Node identity, redaction classification,
# capability honesty, action-command decoding, and delta drop order are the
# properties a security review asks about, and every one of them is provable
# without Blink - no document, no frame, no accessibility tree. They are the
# cheapest tests in the component and the ones that must never be skipped.
#
# Two of them still need the generated mojom bindings, so they are a Chromium
# build rather than a bare gtest: action_command_translator_unittest.cc
# decodes wire commands, and page_capabilities_unittest.cc asserts the wire
# identity gap. The rest depend on nothing generated at all.
#
# The adapter tests that do need Blink are the render-view tests in test/, and
# the end-to-end assertions against the fixture corpus are browser tests, also
# in test/.
source_set("unit_tests") {
  testonly = true

  sources = [
    "action_accessibility_mapping_unittest.cc",
    "action_command_translator_unittest.cc",
    "budget_ledger_unittest.cc",
    "content_metadata_unittest.cc",
    "delta_coalescer_unittest.cc",
    "dom_mutation_signal_source_unittest.cc",
    "field_redaction_unittest.cc",
    "high_risk_pattern_detector_unittest.cc",
    "node_precondition_checker_unittest.cc",
    "observation_limits_unittest.cc",
    "page_capabilities_unittest.cc",
    "semantic_graph_store_identity_unittest.cc",
    "semantic_graph_store_security_unittest.cc",
    "semantic_graph_store_unittest.cc",
    "snapshot_graph_projection_unittest.cc",
  ]

  deps = [
    ":renderer",
    "//base",
    "//base/test:test_support",
    "//taffy/contracts/bip/mojom",
    "//testing/gtest",

    # dom_mutation_signal_source_unittest.cc classifies blink::WebDomMutation
    # records, which are a plain struct: the translation is decided without a
    # document, a frame, or an accessibility tree, so it belongs in this
    # target rather than in the render-view tests. The headers are all it
    # needs; nothing here links or starts Blink.
    "//third_party/blink/public:blink_headers",
  ]
}

# The render-view tests, by reference. `//taffy:taffy_browsertests` is the
# binary that carries this, and it has to be that one rather than
# `:taffy_unittests`: content::RenderViewTest initializes Blink per test, and a
# unit-test launcher has already initialized it for the process, so those cases
# abort on `DCHECK failed: !did_initialize_blink_`. Upstream reaches the same
# answer for the same reason — its own RenderViewTest suites under
# //components run out of `components_browsertests`.
#
# AUDITED on 2026-08-19: before that date `gn refs` answered "Nothing
# references this." here, so all twenty cases behind it, the redaction canary
# sweep included, were in no binary at all. `./tools/chromium/orphan-targets`
# is the check that now says so.
group("test_support") {
  testonly = true
  public_deps = [ "//taffy/renderer/test:tests" ]
}

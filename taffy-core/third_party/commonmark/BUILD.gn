import("//build/config/android/rules.gni")

java_prebuilt("commonmark_core_java") {
  jar_path = "lib/commonmark-0.30.0.jar"
  supports_android = true
  requires_android = false
  jar_excluded_patterns = [ "module-info.class" ]
}

java_prebuilt("commonmark_tables_java") {
  jar_path = "lib/commonmark-ext-gfm-tables-0.30.0.jar"
  supports_android = true
  requires_android = false
  jar_excluded_patterns = [ "module-info.class" ]
  deps = [ ":commonmark_core_java" ]
}

java_group("commonmark_java") {
  public_deps = [
    ":commonmark_core_java",
    ":commonmark_tables_java",
  ]
}

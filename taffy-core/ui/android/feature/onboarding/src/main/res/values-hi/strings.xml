    <!-- Screen SCR-001 — Welcome -->
    <string name="taffy_welcome_badge">एआई-नेटिव ब्राउज़र</string>
    <string name="taffy_welcome_headline">पूरा ब्राउज़र। Taffy सिर्फ़ तब, जब आप कहें।</string>
    <string name="taffy_welcome_body">पहले पेज से ही विज्ञापन और ट्रैकर ब्लॉक। Taffy नीचे की पट्टी में चुपचाप बैठा रहता है जब तक आप न कहें — और जब कुछ करता है, तो हर स्रोत दिखाता है।</string>
    <string name="taffy_welcome_promise">बिना पूछे आपके फ़ोन से कुछ नहीं जाता।</string>
    <string name="taffy_welcome_start">ब्राउज़ करना शुरू करें</string>
    <string name="taffy_welcome_footnote">आप Taffy से बाद में मिल सकते हैं, या कभी नहीं।</string>
    <string name="taffy_welcome_theme_label">दिखावट</string>
    <string name="taffy_welcome_theme_light">हल्का</string>
    <string name="taffy_welcome_theme_dark">गहरा</string>


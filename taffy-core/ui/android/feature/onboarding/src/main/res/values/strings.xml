    <string name="taffy_language_chip_hindi">हिन्दी</string>
    <string name="taffy_language_chip_description">Region and language: %1$s. Change it.</string>

    <!-- Screen SCR-004 — AI setup. One route, and the option to answer later. -->
    <string name="taffy_ai_setup_title">How should Taffy think?</string>
    <string name="taffy_ai_setup_body">Connect your own provider now, or set this up later.</string>
    <string name="taffy_ai_setup_routes_label">Where your requests go</string>
    <plurals name="taffy_ai_setup_routes_count">
        <item quantity="one">%1$d way</item>
        <item quantity="other">%1$d ways</item>
    </plurals>
    <string name="taffy_ai_setup_own_key_title">Use your own key</string>
    <string name="taffy_ai_setup_own_key_cost">You pay your provider</string>
    <string name="taffy_ai_setup_own_key_body">Save a provider key on the next screen. It stays on this phone.</string>
    <string name="taffy_ai_setup_assure_compact">Passwords, payment details and one-time codes never go to a model.</string>
    <string name="taffy_ai_setup_continue">Continue</string>
    <string name="taffy_ai_setup_choose_provider">Choose a provider</string>
    <string name="taffy_ai_setup_set_up_later">Set up later</string>
    <string name="taffy_ai_setup_change_later">You can change this any time in Settings.</string>

    <!-- Shared by the sequence -->
    <string name="taffy_onboarding_continue">Continue</string>

    <!-- Screen SCR-007 — Get started. The name and the picture are both
         optional and both stay on the device (decision 0201). -->
    <string name="taffy_get_started_headline">Make it yours</string>
    <string name="taffy_get_started_body">A name and a picture, if you want them. Both stay on this phone.</string>
    <string name="taffy_get_started_name_label">Your name</string>
    <string name="taffy_get_started_name_placeholder">Optional</string>
    <string name="taffy_get_started_face_label">Picture</string>
    <!-- %1$d the position of this picture, %2$d how many there are. -->
    <string name="taffy_get_started_face_choice">Picture %1$d of %2$d</string>
    <string name="taffy_get_started_promise_account">No account, and nothing to sign in to.</string>
    <string name="taffy_get_started_promise_servers">TaffyGo runs no servers of its own.</string>
    <string name="taffy_get_started_promise_key">Taffy uses an AI key you bring — or none at all.</string>
    <string name="taffy_get_started_data_link">How TaffyGo handles your data</string>
    <string name="taffy_get_started_data_title">How TaffyGo handles your data</string>
    <string name="taffy_get_started_data_device">Your name, your picture, your history, your bookmarks and anything Taffy remembers are kept on this phone. There is no account and no TaffyGo server to send them to.</string>
    <string name="taffy_get_started_data_provider">Taffy asks an AI provider something only once you give it a key, or sign in to a plan you already pay for. Those requests go to that provider and to nobody else.</string>
    <string name="taffy_get_started_data_sites">Websites see what any browser shows them. Ads and trackers are blocked before they load.</string>
    <!-- %1$s the installed version name. -->
    <string name="taffy_get_started_version">Version %1$s</string>

    <!--
      One sentence per way a task can end without finishing, and two for a
      pause the provider caused. The state chip keeps its one word; these are
      the line beside it, and the pill says the same one.
    -->
    <string name="taffy_assistant_failed">Couldn\'t finish — Taffy could not read enough to answer</string>
    <string name="taffy_assistant_failed_provider">Couldn\'t finish — Taffy couldn\'t reach your provider</string>
    <string name="taffy_assistant_failed_refused">Couldn\'t finish — your AI provider didn\'t accept this request</string>
    <string name="taffy_assistant_failed_limit">Your AI provider limit was reached. Resume later, or switch models in settings.</string>
    <string name="taffy_assistant_failed_offline">You\'re offline. Taffy will continue when you\'re back online.</string>
    <string name="taffy_assistant_failed_budget">Couldn\'t finish — Taffy ran out of steps</string>
    <string name="taffy_assistant_failed_deadline">Couldn\'t finish — Taffy ran out of time</string>
    <string name="taffy_assistant_failed_policy">Couldn\'t finish — Taffy\'s moves were refused</string>
    <string name="taffy_assistant_failed_unverified">Couldn\'t finish — Taffy couldn\'t confirm a step on the page</string>
    <!-- Not "stopped unexpectedly": nothing inside Taffy broke. The core will
         not guess whether a move took effect, and this is said while the task
         is still held as well as after it ends, so it claims neither
         (decision 0229). -->
    <string name="taffy_assistant_failed_outcome_unknown">Taffy won\'t repeat a step it isn\'t sure of. Check the page to see if it happened.</string>
    <!-- Taffy's own failure, and the only one that says so. It names the one
         thing that helps, because a heading and a body that both say "stopped
         unexpectedly" leave a person nothing to do. -->
    <string name="taffy_assistant_failed_internal">Couldn\'t finish — something went wrong inside Taffy. Try asking again.</string>
    <string name="taffy_assistant_paused_limit">Paused — your AI provider limit was reached. Resume later, or switch models in settings.</string>
    <string name="taffy_assistant_paused_offline">Paused — you\'re offline. Resume when you\'re back online.</string>
    <!-- Not "offline" and not "failed": the request left and nothing came back,
         so the device may have a working network and the answer may already have
         been billed. The sentence claims only what is known (decision 0217). -->
    <string name="taffy_assistant_paused_no_answer">Paused — Taffy didn\'t hear back from the provider. Resume to continue.</string>
    <string name="taffy_assistant_paused_busy">Paused — your AI provider is busy right now. Resume to try again.</string>
    <!-- A pause that has not settled yet: the counts it would print are the ones it
         held before it began stopping, and its denominator is often zero. -->
    <string name="taffy_assistant_pausing">Pausing — Taffy is finishing the step it started.</string>


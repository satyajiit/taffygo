    <string name="taffy_privacy_export">Export everything</string>
    <string name="taffy_privacy_delete">Delete everything</string>
    <string name="taffy_privacy_workspaces_stay">Clearing browsing data never deletes workspaces, Library, Memory, or saved sign-ins.</string>
    <string name="taffy_privacy_export_scope">Your export includes saved Taffy work, visible Saved sign-ins and Saved details records, history, bookmarks, recent download records, site and blocking settings, Time on sites, and app choices. It never includes passwords, your keys, cookies, cached pages, open tabs, or anything that lets an open task keep working.</string>
    <string name="taffy_privacy_external_copies">Deleting this browser\'s data cannot delete downloaded or exported files, copies in another app, drive, message, or recipient\'s hands, or data held by websites and AI providers.</string>
    <string name="taffy_privacy_export_choosing">Choose where Android should create the export.</string>
    <string name="taffy_privacy_export_writing">Writing the checked export…</string>
    <string name="taffy_privacy_export_succeeded">Export complete. The copy you chose is now outside TaffyGo and will not be removed if you delete this browser\'s data.</string>
    <string name="taffy_privacy_export_failed">Nothing complete was exported. Check the destination and try again.</string>
    <string name="taffy_privacy_export_cancelled">Export cancelled. No destination was written.</string>
    <string name="taffy_privacy_delete_confirm_title">Delete all data on this phone?</string>
    <string name="taffy_privacy_delete_confirm_body">TaffyGo will first stop open tasks and close access to Saved sign-ins and your keys. Android will then close the app and erase all data it stores, including browsing data, workspaces, Library, Memory, settings, and cached files. This cannot be undone.</string>
    <string name="taffy_privacy_delete_external_limit">Downloaded files and earlier exports belong to their destinations. This does not delete copies held by another app, drive, recipient, website, AI provider, or online account.</string>
    <string name="taffy_privacy_delete_confirm">Delete and close TaffyGo</string>
    <string name="taffy_privacy_delete_keep">Keep my data</string>
    <string name="taffy_privacy_delete_starting">Closing live access before Android erases the app\'s data…</string>
    <string name="taffy_privacy_delete_started">Android accepted the erase request. TaffyGo will close. The welcome screen on your next launch is the check that this phone\'s app data is gone.</string>
    <string name="taffy_privacy_delete_failed">Android did not accept the erase request. TaffyGo closed its live profile first. Restart the app, then try again.</string>


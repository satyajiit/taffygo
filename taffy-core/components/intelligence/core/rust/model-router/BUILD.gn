import("//build/rust/rust_static_library.gni")
import("//taffy/services/core/crate_sources.gni")

rust_static_library("model_router") {
  crate_name = "model_router"
  crate_root = taffy_model_router_crate_root
  sources = taffy_model_router_sources
  inputs = taffy_model_router_inputs
  edition = "2021"
  deps = [ "//third_party/rust/serde/v1:lib" ]
  visibility = [
    "//taffy/components/intelligence/core/rust/core-runtime:*",
    "//taffy/components/intelligence/core/rust/loop-kernel:*",
    "//taffy/components/intelligence/core/rust/task-engine:*",
  ]
}

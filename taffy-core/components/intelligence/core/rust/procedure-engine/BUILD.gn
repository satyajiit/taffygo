import("//build/rust/rust_static_library.gni")
import("//taffy/services/core/crate_sources.gni")

rust_static_library("procedure_engine") {
  crate_name = "procedure_engine"
  crate_root = taffy_procedure_engine_crate_root
  sources = taffy_procedure_engine_sources
  edition = "2021"
  deps = [
    "//taffy/components/intelligence/core/rust/task-engine:task_engine",
    "//taffy/components/security/core/rust/policy-engine:policy_engine",
    "//taffy/contracts/bip/rust/bip-types:bip_types",
  ]
  visibility = [
    "//taffy/components/intelligence/core/rust/core-runtime:*",
    "//taffy/components/intelligence/core/rust/loop-kernel:*",
  ]
}

    "//base",
    "//crypto",
    "//sql",
    "//url",
  ]

  visibility = [
    ":unit_tests",
    "//taffy/browser:*",

    # The Android restore lifecycle reads and reconciles the dormant target
    # this plane owns. It is browser-process code in a subdirectory, so
    # "//taffy/browser:*" does not reach it.
    "//taffy/browser/android:*",
    "//taffy/test:benchmark_audit_support",
    "//taffy/test:workspace_snapshot_compat_unit_tests",

    # The core-recovery browser test drives a real profile through the dormant
    # target's own SQL. No product target depends back on the test.
    "//taffy/test/recovery:*",
  ]
